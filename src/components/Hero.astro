---
---

<section class="hero" id="inicio">
	<!--
		Espacio reservado para fotografía editorial real (ver
		docs/HOMEPAGE_SPEC.md § Photography Production Needs — HERO). Mientras
		no exista: un bloque textil (no un mockup ni un degradado con letra).
		Al llegar la foto, reemplaza .hero__visual por el componente Image (o
		una etiqueta img) dentro de .hero__media — el layout no cambia.
	-->
	<div class="hero__media">
		<div class="hero__visual" role="img" aria-label="Sandalias Maygel — fotografía próximamente"></div>
	</div>

	<div class="container hero__text">
		<h1>Hecho despacio.</h1>
		<p class="hero__subtitle">
			Sandalias artesanales, hechas por encargo en nuestro taller familiar.
		</p>
		<a class="btn" href="#catalogo">Descubrir la colección</a>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(1rem, 3vw, 1.75rem);
		padding-bottom: clamp(3rem, 7vw, 5rem);
	}

	.hero__media {
		width: 100%;
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.hero__visual {
		position: relative;
		width: 100%;
		height: clamp(360px, 62vh, 640px);
		overflow: hidden;
		background: linear-gradient(165deg, #3a2414 0%, #5a3a20 48%, #7a5230 100%);
	}

	/* Textura tipo lino/papel de archivo: ruido sutil vía SVG turbulence,
	   nunca un icono ni una letra — evita la sensación de mockup mientras no
	   hay fotografía real. */
	.hero__visual::before {
		content: "";
		position: absolute;
		inset: 0;
		opacity: 0.35;
		mix-blend-mode: overlay;
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
	}

	.hero__visual::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 18% 20%, rgba(255, 255, 255, 0.1), transparent 45%),
			radial-gradient(circle at 85% 88%, rgba(0, 0, 0, 0.3), transparent 55%);
	}

	.hero__text {
		max-width: 46ch;
	}

	.hero__text h1 {
		font-size: clamp(2.75rem, 8vw, 5.5rem);
		line-height: 0.96;
		margin-bottom: 1.25rem;
	}

	.hero__subtitle {
		max-width: 38ch;
		color: var(--color-muted);
		font-size: 1.0625rem;
		margin-bottom: 1.75rem;
	}

	@media (min-width: 768px) {
		.hero__visual {
			height: clamp(480px, 72vh, 760px);
		}
	}
</style>
