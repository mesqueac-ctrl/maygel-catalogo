---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.svg";
---

<section class="hero" id="inicio">
	<div class="container">
		<div class="hero__text">
			<h1>Sandalias hechas a mano, con alma de familia</h1>
			<p class="hero__subtitle">
				Cada par de Maygel se hace a mano, con cuero seleccionado y el cuidado de un taller familiar.
			</p>
			<a class="btn" href="#catalogo">Ver catálogo</a>
		</div>
	</div>

	<div class="hero__image">
		<Image src={heroImage} alt="Sandalias artesanales Maygel" width={1600} height={1100} priority />
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(4rem, 10vw, 7rem);
		padding-bottom: var(--space-section);
	}

	.hero__text {
		max-width: 34ch;
		margin-bottom: clamp(3.5rem, 8vw, 5.5rem);
	}

	.hero__text h1 {
		font-size: clamp(2.4rem, 6vw, 4rem);
		margin-bottom: 1.75rem;
	}

	.hero__subtitle {
		max-width: 44ch;
		color: var(--color-accent-soft);
		font-weight: 300;
		font-size: 1.0625rem;
		margin-bottom: 2.5rem;
	}

	.hero__image {
		width: 100%;
	}

	.hero__image :global(img) {
		width: 100%;
		height: clamp(320px, 55vh, 620px);
		object-fit: cover;
	}
</style>
