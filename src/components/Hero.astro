---
import { Image } from "astro:assets";
import heroImage from "../assets/hero.svg";
---

<section class="hero" id="inicio">
	<div class="container hero__inner">
		<div class="hero__text">
			<h1>Sandalias hechas a mano, con alma de familia</h1>
			<p class="hero__subtitle">
				Cada par de sandalias planas Maygel se elabora a mano bajo pedido, con cuero seleccionado y el cuidado de un taller familiar.
			</p>
			<a class="btn" href="#catalogo">Ver catálogo</a>
		</div>

		<div class="hero__image">
			<Image src={heroImage} alt="Sandalias artesanales Maygel" width={1600} height={1100} priority />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(2.5rem, 6vw, 4rem);
		padding-bottom: var(--space-section);
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 6vw, 4rem);
	}

	.hero__text {
		max-width: 34ch;
	}

	.hero__text h1 {
		font-size: clamp(2.6rem, 7vw, 5.75rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin-bottom: 1.75rem;
	}

	.hero__subtitle {
		max-width: 44ch;
		color: var(--color-accent-soft);
		font-weight: 300;
		font-size: 1.0625rem;
		margin-bottom: 2.5rem;
	}

	.hero__image {
		width: 100%;
	}

	.hero__image :global(img) {
		width: 100%;
		height: clamp(280px, 50vh, 420px);
		object-fit: cover;
	}

	@media (min-width: 860px) {
		.hero {
			padding-top: clamp(3rem, 6vw, 4.5rem);
		}

		.hero__inner {
			flex-direction: row;
			align-items: stretch;
			gap: clamp(3rem, 6vw, 5rem);
		}

		.hero__text {
			flex: 0 0 auto;
			width: 42%;
			display: flex;
			flex-direction: column;
			justify-content: center;
		}

		.hero__image {
			flex: 1;
			width: auto;
		}

		.hero__image :global(img) {
			height: 100%;
			min-height: 480px;
			max-height: 80vh;
		}
	}
</style>
