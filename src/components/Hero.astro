---
import { Image } from "astro:assets";
import { fotoDeApoyo } from "../lib/productos";
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL, SEO_PRODUCTO } from "../consts";

const apoyo = await fotoDeApoyo(["luna"]);
const heroImagen = apoyo?.imagen ?? null;
const heroImagenEsRemota = heroImagen?.startsWith("http") ?? false;
const heroAlt = SEO_PRODUCTO.luna?.alt ?? apoyo?.alt ?? "Sandalia Luna de Maygel, plana con tiras finas y tobillera";
const whatsapp = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
---

<section class="hero" id="inicio">
	<div class="container hero__inner">
		<div class="hero__text">
			<h1>Sandalias hechas a mano, para ti.</h1>
			<p class="hero__subtitle">Taller familiar en Soledad. Cada par se fabrica bajo pedido.</p>
			<div class="hero__acciones">
				<a class="btn" href="#catalogo">Ver la colección</a>
				<a class="btn btn-outline" href={whatsapp} target="_blank" rel="noopener noreferrer">Pedir por WhatsApp</a>
			</div>
		</div>
		<div class="hero__media">
			{
				heroImagen ? (
					heroImagenEsRemota ? (
						<Image
							src={heroImagen}
							alt={heroAlt}
							width={1200}
							height={1500}
							widths={[600, 1200, 1800]}
							sizes="(min-width: 900px) 48vw, 100vw"
							format="webp"
							loading="eager"
							fetchpriority="high"
						/>
					) : (
						<img src={heroImagen} alt={heroAlt} width="1200" height="1500" loading="eager" fetchpriority="high" decoding="async" />
					)
				) : (
					<div class="hero__visual" role="img" aria-label="Sandalias Maygel — fotografía próximamente"></div>
				)
			}
		</div>
	</div>
</section>

<style>
	.hero {
		padding: 1rem 0 1rem;
		background: var(--color-bg);
		color: var(--color-text);
	}

	.hero h1 {
		color: var(--color-text);
	}

	.hero__inner {
		display: grid;
		gap: 1.5rem;
	}

	.hero__text h1 {
		font-size: clamp(2.05rem, 8.4vw, 4.75rem);
		margin-bottom: 0.9rem;
		hyphens: none;
		overflow-wrap: normal;
		word-break: normal;
		text-wrap: balance;
	}

	.hero__subtitle {
		font-size: 1.0625rem;
		color: var(--color-text);
		max-width: 34ch;
		margin-bottom: 1.5rem;
	}

	.hero__acciones {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.65rem;
		max-width: 22rem;
	}

	.hero__acciones :global(.btn),
	.hero__acciones :global(.btn-outline) {
		justify-content: center;
		width: 100%;
	}

	.hero__media {
		border-radius: var(--radius);
		overflow: hidden;
		aspect-ratio: 4 / 5;
		background: var(--color-image-fallback);
	}

	.hero__media :global(img),
	.hero__visual {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 900px) {
		.hero {
			padding: 2rem 0 1.25rem;
		}

		.hero__inner {
			grid-template-columns: 1.05fr 0.95fr;
			align-items: center;
			gap: 3rem;
		}

		.hero__acciones {
			flex-direction: row;
			align-items: center;
			max-width: none;
		}

		.hero__acciones :global(.btn),
		.hero__acciones :global(.btn-outline) {
			width: auto;
		}

		.hero__media {
			max-height: 640px;
		}
	}
</style>
