---
import ProductCard from "./ProductCard.astro";
import { listarDisponibles } from "../lib/productos";
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL } from "../consts";

const productos = await listarDisponibles();
const whatsappLink = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
const cantidad = productos.length;
---

<section class="catalogo section" id="catalogo">
	<div class="container">
		<header class="catalogo__header" data-reveal>
			<h2 class="section-title">La colección</h2>
			<p class="catalogo__subtitle">Elige tu modelo y tu color favorito.</p>
			<p class="catalogo__tallas">
				<a href="/ayuda#tallas">Consulta tu talla</a>
			</p>
		</header>

		{
			cantidad === 0 ? (
				<div class="catalogo__vacio">
					<p>Por ahora no tenemos modelos publicados aquí.</p>
					<a class="btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
						Escríbenos por WhatsApp
					</a>
				</div>
			) : (
				<div class="catalogo__grid">
					{productos.map((producto) => (
						<ProductCard producto={producto} />
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.catalogo.section {
		padding-top: clamp(2.75rem, 6vw, 5rem);
	}

	.catalogo__header {
		margin-bottom: 1.75rem;
	}

	.catalogo__subtitle {
		margin-top: 0.7rem;
		color: var(--color-text);
		max-width: 42ch;
	}

	.catalogo__tallas a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--color-cta);
		font-weight: 600;
	}

	.catalogo__vacio {
		display: grid;
		gap: 1rem;
		max-width: 40ch;
	}

	.catalogo__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		align-items: stretch;
	}

	@media (min-width: 768px) {
		.catalogo__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.15rem;
		}
	}

	@media (min-width: 1200px) {
		.catalogo__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1.25rem;
		}
	}
</style>
