---
import {
	COLORES_VALIDOS,
	COLORES_METADATA,
	CATEGORIAS_VALIDAS,
	coloresComoLista,
	imagenesColoresComoMapa,
	formatearPrecio,
	type ProductoRegistro,
} from "../../lib/productos";

interface Props {
	producto?: ProductoRegistro;
}

const { producto } = Astro.props;
const esEdicion = Boolean(producto);
const coloresSeleccionados = coloresComoLista(producto?.colores);
const imagenesColoresActuales = imagenesColoresComoMapa(producto?.imagenesColores);
const precioPreview = producto ? formatearPrecio(producto.precio) : "$ 0";
---

<div class="editor">
	<form class="formulario" method="POST" action="/admin/api/guardar" enctype="multipart/form-data" id="form-producto">
		{esEdicion && <input type="hidden" name="id" value={producto!.id} />}
		{esEdicion && <input type="hidden" name="imagenActual" value={producto!.imagen} />}
		<input type="hidden" name="imagenesColoresActual" value={JSON.stringify(imagenesColoresActuales)} />
		<input type="hidden" name="usarComoPrincipal" id="usar-como-principal" value="" />

		<label class="campo">
			<span>Nombre</span>
			<input type="text" name="nombre" id="campo-nombre" required maxlength="120" value={producto?.nombre ?? ""} placeholder="Ej: Luna" />
		</label>

		<label class="campo">
			<span>Precio (pesos, solo números)</span>
			<input type="number" name="precio" id="campo-precio" required min="0" step="1000" value={producto?.precio ?? ""} placeholder="45000" />
		</label>

		<fieldset class="campo">
			<legend>Colores</legend>
			<p class="ayuda">Toca el círculo de los colores que fabricas. Luego puedes ponerle foto a cada uno.</p>
			<div class="swatches">
				{
					COLORES_VALIDOS.map((color) => {
						const meta = COLORES_METADATA[color];
						const marcado = coloresSeleccionados.includes(color);
						return (
							<label class="swatch">
								<input type="checkbox" name="colores" value={color} checked={marcado} data-color={color} />
								<span class="swatch__dot" style={`background:${meta.hex};border-color:${meta.border}`}></span>
								<span class="swatch__name">{meta.nombre}</span>
							</label>
						);
					})
				}
			</div>
			<p class="aviso-error" id="error-colores" hidden>Elige al menos un color.</p>
		</fieldset>

		<label class="campo">
			<span>Descripción (opcional)</span>
			<textarea name="descripcion" rows="3" maxlength="600" placeholder="Si la dejas vacía, la ficha usa un texto corto automático.">{producto?.descripcion ?? ""}</textarea>
		</label>

		<div class="campo">
			<span>Foto principal</span>
			{
				esEdicion && (
					<img class="foto-actual" id="foto-principal-preview" src={producto!.imagen} alt="" />
				)
			}
			{
				!esEdicion && (
					<img class="foto-actual" id="foto-principal-preview" alt="" hidden />
				)
			}
			<div class="drop" data-drop-principal>
				<p>Arrastra una foto, elígela o tómala con el celular.</p>
				<input id="campo-foto" type="file" name="foto" accept="image/*" capture="environment" required={!esEdicion} />
			</div>
		</div>

		<div class="fotos-color" id="fotos-color">
			{
				COLORES_VALIDOS.map((color) => {
					const meta = COLORES_METADATA[color];
					const img = imagenesColoresActuales[color];
					const visible = coloresSeleccionados.includes(color);
					return (
						<div class="foto-color" data-foto-color={color} hidden={!visible}>
							<p>Foto en {meta.nombre} (opcional)</p>
							{img && <img src={img} alt="" />}
							<input type="file" name={`foto_color_${color}`} accept="image/*" capture="environment" />
							<label class="quitar">
								<input type="checkbox" name={`quitar_foto_color_${color}`} value="si" />
								Quitar esta foto
							</label>
							<button type="button" class="btn-texto" data-promover={color} hidden={!img}>
								Usar como foto principal
							</button>
						</div>
					);
				})
			}
		</div>

		<details class="mas">
			<summary>Más opciones</summary>
			<label class="campo">
				<span>Tallas</span>
				<input type="text" name="tallas" value={producto?.tallas ?? "Según pedido"} />
				<span class="ayuda">Lo normal es “Según pedido”.</span>
			</label>
			<label class="campo">
				<span>Precio con descuento (opcional)</span>
				<input type="number" name="precioOferta" min="0" step="1000" value={producto?.precioOferta ?? ""} />
			</label>
			<label class="campo">
				<span>Categoría</span>
				<select name="categoria">
					<option value="">Sin categoría</option>
					{CATEGORIAS_VALIDAS.map((cat) => (
						<option value={cat} selected={producto?.categoria === cat}>{cat}</option>
					))}
				</select>
			</label>
			{esEdicion && (
				<p class="ayuda">El enlace de esta sandalia no cambia aunque edites el nombre ({producto!.slug}).</p>
			)}
			<label class="opcion">
				<input type="checkbox" name="destacado" value="si" checked={producto?.destacado === true} />
				Destacar en la portada
			</label>
		</details>

		<fieldset class="campo">
			<legend>¿Se ve en la página?</legend>
			<label class="opcion">
				<input type="radio" name="disponible" value="si" checked={producto?.disponible !== false} />
				Sí, mostrar
			</label>
			<label class="opcion">
				<input type="radio" name="disponible" value="no" checked={producto?.disponible === false} />
				No, ocultar
			</label>
		</fieldset>

		<div class="acciones">
			<button class="btn-admin" type="submit">{esEdicion ? "Guardar cambios" : "Guardar sandalia"}</button>
			<a class="btn-ghost" href="/admin/productos">Cancelar</a>
		</div>
	</form>

	<aside class="preview" aria-live="polite">
		<p class="preview__label">Así se ve la tarjeta</p>
		<article class="card-preview">
			<div class="card-preview__foto">
				<img id="preview-img" src={producto?.imagen ?? ""} alt="" hidden={!producto?.imagen} />
			</div>
			<h3 id="preview-nombre">{producto?.nombre || "Nombre"}</h3>
			<p id="preview-precio">{precioPreview}</p>
			<div class="card-preview__dots" id="preview-dots"></div>
		</article>
	</aside>
</div>

<style>
	.editor {
		display: grid;
		gap: 1.5rem;
	}

	@media (min-width: 900px) {
		.editor {
			grid-template-columns: minmax(0, 1fr) 240px;
			align-items: start;
			gap: 2rem;
		}

		.preview {
			position: sticky;
			top: 5.5rem;
		}
	}

	.formulario {
		display: grid;
		gap: 1.15rem;
	}

	.campo span,
	.campo legend,
	.fotos-color p {
		display: block;
		font-weight: 600;
		margin-bottom: 0.4rem;
	}

	.campo input[type="text"],
	.campo input[type="number"],
	.campo textarea,
	.campo select {
		width: 100%;
		min-height: 44px;
		padding: 0.65rem 0.85rem;
		border: 1.5px solid var(--color-text);
		border-radius: 0.85rem;
		font: inherit;
		background: var(--color-surface);
		color: var(--color-text);
	}

	.ayuda {
		font-weight: 400;
		font-size: 0.875rem;
		opacity: 0.85;
	}

	.swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.swatch {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		min-width: 44px;
		cursor: pointer;
		font-size: 0.75rem;
	}

	.swatch input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.swatch__dot {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 2px solid #2b1a12;
		box-sizing: border-box;
	}

	.swatch:has(input:checked) .swatch__dot {
		outline: 3px solid var(--color-cta);
		outline-offset: 2px;
	}

	.drop {
		border: 1.5px dashed var(--color-text);
		border-radius: 0.85rem;
		padding: 1rem;
		background: var(--color-surface);
	}

	.drop input {
		display: block;
		margin-top: 0.5rem;
		width: 100%;
	}

	.foto-actual {
		width: 120px;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 0.85rem;
		margin-bottom: 0.5rem;
		background: #ead9c6;
	}

	.foto-color {
		background: var(--color-surface);
		border-radius: 0.85rem;
		padding: 0.85rem;
		margin-bottom: 0.5rem;
	}

	.foto-color img {
		width: 72px;
		height: 90px;
		object-fit: cover;
		border-radius: 0.5rem;
		margin-bottom: 0.4rem;
	}

	.mas {
		background: var(--color-surface);
		border-radius: 0.85rem;
		padding: 0.4rem 0.9rem;
	}

	.mas summary {
		min-height: 44px;
		display: flex;
		align-items: center;
		font-weight: 600;
		cursor: pointer;
	}

	.opcion {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
	}

	.acciones {
		position: sticky;
		bottom: 0;
		display: flex;
		gap: 0.6rem;
		padding: 0.75rem 0;
		background: var(--color-bg);
	}

	.btn-admin,
	.btn-ghost,
	.btn-texto {
		min-height: 44px;
		padding: 0.55rem 1.1rem;
		border-radius: var(--radius-pill);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.btn-admin {
		background: var(--color-cta);
		color: #fff;
		border: none;
	}

	.btn-ghost,
	.btn-texto {
		background: transparent;
		border: 1.5px solid var(--color-text);
		color: var(--color-text);
	}

	.card-preview {
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: 0 10px 24px rgba(43, 26, 18, 0.08);
	}

	.card-preview__foto {
		aspect-ratio: 4 / 5;
		background: #ead9c6;
	}

	.card-preview__foto img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-preview h3,
	.card-preview p {
		margin: 0;
		padding: 0 0.75rem;
	}

	.card-preview h3 {
		padding-top: 0.7rem;
		font-size: 1rem;
	}

	.card-preview__dots {
		display: flex;
		gap: 0.3rem;
		padding: 0.45rem 0.75rem 0.85rem;
	}

	.card-preview__dots span {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 1.5px solid #2b1a12;
	}

	.aviso-error {
		color: #8c3a22;
		font-size: 0.875rem;
	}

	.quitar {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 44px;
		font-size: 0.875rem;
	}
</style>

<script>
	const meta: Record<string, { hex: string; border: string }> = {
		Negro: { hex: "#222222", border: "#222222" },
		Blanco: { hex: "#FFFFFF", border: "#2B1A12" },
		Miel: { hex: "#C47C35", border: "#B56E28" },
		Beige: { hex: "#E7DACB", border: "#2B1A12" },
		Café: { hex: "#6F4E37", border: "#4F3627" },
		Plateado: { hex: "#C7C7C7", border: "#A0A0A0" },
	};

	async function comprimirFoto(archivo: File): Promise<File> {
		if (!archivo.type.startsWith("image/") || archivo.type === "image/svg+xml") {
			return archivo;
		}
		let bitmap: ImageBitmap;
		try {
			bitmap = await createImageBitmap(archivo, { imageOrientation: "from-image" });
		} catch {
			bitmap = await createImageBitmap(archivo);
		}
		const max = 1600;
		let ancho = bitmap.width;
		let alto = bitmap.height;
		if (Math.max(ancho, alto) > max) {
			const escala = max / Math.max(ancho, alto);
			ancho = Math.round(ancho * escala);
			alto = Math.round(alto * escala);
		}
		const canvas = document.createElement("canvas");
		canvas.width = ancho;
		canvas.height = alto;
		const ctx = canvas.getContext("2d");
		if (!ctx) {
			bitmap.close();
			return archivo;
		}
		ctx.drawImage(bitmap, 0, 0, ancho, alto);
		bitmap.close();
		const blob: Blob | null = await new Promise((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.82));
		if (!blob) return archivo;
		const nombre = archivo.name.replace(/\.[^.]+$/, "") + ".jpg";
		return new File([blob], nombre, { type: "image/jpeg" });
	}

	function asignarArchivo(input: HTMLInputElement, archivo: File) {
		const transferencia = new DataTransfer();
		transferencia.items.add(archivo);
		input.files = transferencia.files;
	}

	async function alElegirFoto(input: HTMLInputElement, preview?: HTMLImageElement | null) {
		const original = input.files?.[0];
		if (!original) return;
		const comprimida = await comprimirFoto(original);
		asignarArchivo(input, comprimida);
		if (preview) {
			preview.src = URL.createObjectURL(comprimida);
			preview.hidden = false;
		}
		const previewCard = document.getElementById("preview-img") as HTMLImageElement | null;
		if (previewCard && input.id === "campo-foto") {
			previewCard.src = preview?.src ?? URL.createObjectURL(comprimida);
			previewCard.hidden = false;
		}
	}

	function pintarPreview() {
		const nombre = (document.getElementById("campo-nombre") as HTMLInputElement)?.value.trim() || "Nombre";
		const precioEl = document.getElementById("preview-precio");
		const nombreEl = document.getElementById("preview-nombre");
		const precioInput = document.getElementById("campo-precio") as HTMLInputElement | null;
		if (nombreEl) nombreEl.textContent = nombre;
		if (precioEl && precioInput) {
			const n = Number(precioInput.value);
			precioEl.textContent = Number.isFinite(n)
				? new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n)
				: "$ 0";
		}
		const dots = document.getElementById("preview-dots");
		if (!dots) return;
		dots.innerHTML = "";
		document.querySelectorAll<HTMLInputElement>('input[name="colores"]:checked').forEach((check) => {
			const color = check.value;
			const span = document.createElement("span");
			const datos = meta[color];
			if (datos) {
				span.style.background = datos.hex;
				span.style.borderColor = datos.border;
			}
			dots.appendChild(span);
		});
	}

	document.querySelectorAll<HTMLInputElement>('input[name="colores"]').forEach((check) => {
		const color = check.dataset.color;
		const bloque = document.querySelector<HTMLElement>(`[data-foto-color="${color}"]`);
		const sync = () => {
			if (bloque) bloque.hidden = !check.checked;
			pintarPreview();
		};
		check.addEventListener("change", sync);
		sync();
	});

	const fotoPrincipal = document.getElementById("campo-foto") as HTMLInputElement | null;
	const previewPrincipal = document.getElementById("foto-principal-preview") as HTMLImageElement | null;
	fotoPrincipal?.addEventListener("change", () => alElegirFoto(fotoPrincipal, previewPrincipal));

	document.querySelectorAll<HTMLInputElement>('input[name^="foto_color_"]').forEach((input) => {
		input.addEventListener("change", () => alElegirFoto(input));
	});

	const zona = document.querySelector("[data-drop-principal]");
	zona?.addEventListener("dragover", (evento) => {
		evento.preventDefault();
	});
	zona?.addEventListener("drop", async (evento) => {
		evento.preventDefault();
		const archivo = (evento as DragEvent).dataTransfer?.files?.[0];
		if (!archivo || !fotoPrincipal) return;
		asignarArchivo(fotoPrincipal, archivo);
		await alElegirFoto(fotoPrincipal, previewPrincipal);
	});

	document.querySelectorAll<HTMLButtonElement>("[data-promover]").forEach((boton) => {
		boton.addEventListener("click", () => {
			const hidden = document.getElementById("usar-como-principal") as HTMLInputElement | null;
			if (hidden) hidden.value = boton.dataset.promover ?? "";
			boton.textContent = "Se usará como principal al guardar";
		});
	});

	document.getElementById("campo-nombre")?.addEventListener("input", pintarPreview);
	document.getElementById("campo-precio")?.addEventListener("input", pintarPreview);

	document.getElementById("form-producto")?.addEventListener("submit", (evento) => {
		const hayColor = document.querySelectorAll('input[name="colores"]:checked').length > 0;
		const aviso = document.getElementById("error-colores");
		if (!hayColor) {
			evento.preventDefault();
			if (aviso) aviso.hidden = false;
		}
	});

	pintarPreview();
</script>
