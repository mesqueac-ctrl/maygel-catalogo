---
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL } from "../consts";

const whatsappLink = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
---

<a
	class="whatsapp-flotante"
	href={whatsappLink}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Pedir por WhatsApp"
>
	<svg class="whatsapp-flotante__icono" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.24h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74 1.48.64 1.84.7 2.5.59.38-.06 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.10-.23-.17-.48-.29Z"
		/>
	</svg>
</a>

<style>
	.whatsapp-flotante {
		display: none;
	}

	@media (max-width: 779px) {
		.whatsapp-flotante {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			position: fixed;
			z-index: 40;
			right: max(0.85rem, env(safe-area-inset-right, 0px));
			bottom: max(0.85rem, env(safe-area-inset-bottom, 0px));
			width: 52px;
			height: 52px;
			min-width: 44px;
			min-height: 44px;
			padding: 0;
			border-radius: var(--radius-pill);
			background-color: var(--color-cta);
			color: #fff;
			text-decoration: none;
			box-shadow: 0 10px 24px rgba(194, 69, 32, 0.35);
			transition: opacity 0.2s ease, transform 0.2s ease;
		}

		.whatsapp-flotante.is-oculto {
			opacity: 0;
			pointer-events: none;
			transform: translateY(8px);
		}

		:global(body.sitio) {
			padding-bottom: calc(4.75rem + env(safe-area-inset-bottom, 0px));
		}
	}

	.whatsapp-flotante__icono {
		width: 1.45rem;
		height: 1.45rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.whatsapp-flotante {
			transition: none;
		}
	}
</style>

<script>
	const fab = document.querySelector(".whatsapp-flotante");
	const footer = document.querySelector(".footer");
	if (fab && footer && "IntersectionObserver" in window) {
		const observador = new IntersectionObserver(
			([entrada]) => {
				fab.classList.toggle("is-oculto", Boolean(entrada?.isIntersecting));
			},
			{ threshold: 0.12 },
		);
		observador.observe(footer);
	}
</script>
