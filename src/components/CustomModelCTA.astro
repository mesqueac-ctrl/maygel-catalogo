---
import { buildWhatsappLink, MENSAJE_MODELO_PERSONALIZADO } from "../consts";

const whatsappLink = buildWhatsappLink(MENSAJE_MODELO_PERSONALIZADO);
---

<section class="modelo section section--dark">
	<div class="container modelo__inner">
		<!-- Espacio reservado para fotografía real (boceto/referencia de clienta). -->
		<div class="modelo__visual" role="img" aria-label="Consulta de modelo personalizado — fotografía próximamente" data-reveal></div>

		<div class="modelo__texto" data-reveal>
			<h2 class="section-title modelo__titulo">¿Tienes un diseño en mente?</h2>
			<p class="modelo__parrafo">
				Envíanos una foto o referencia por WhatsApp. Revisamos el diseño y te confirmamos si es
				posible fabricarlo.
			</p>
			<a class="btn btn-on-dark" href={whatsappLink} target="_blank" rel="noopener noreferrer">
				Consultar por WhatsApp
			</a>
		</div>
	</div>
</section>

<style>
	.modelo__inner {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}

	.modelo__visual {
		width: 100%;
		aspect-ratio: 16 / 10;
		background: linear-gradient(155deg, #7a5230 0%, #3a2414 100%);
	}

	.modelo__texto {
		max-width: 44ch;
	}

	.modelo__titulo {
		margin-bottom: 1.25rem;
	}

	.modelo__parrafo {
		color: rgba(244, 236, 225, 0.75);
		margin-bottom: 2rem;
		max-width: 42ch;
	}

	@media (min-width: 900px) {
		.modelo__inner {
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: clamp(3rem, 6vw, 5rem);
		}
	}
</style>
