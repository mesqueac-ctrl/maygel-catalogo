---
import { Image } from "astro:assets";
import { buildWhatsappLink, MENSAJE_MODELO_PERSONALIZADO, SEO_PRODUCTO } from "../consts";
import { fotoDeApoyo } from "../lib/productos";

const whatsappLink = buildWhatsappLink(MENSAJE_MODELO_PERSONALIZADO);

const apoyo = await fotoDeApoyo(["nudo", "trazo", "cristal"]);
const imagenReferencia = apoyo?.imagen ?? null;
const imagenEsRemota = imagenReferencia?.startsWith("http") ?? false;
const altReferencia = SEO_PRODUCTO.nudo?.alt ?? apoyo?.alt ?? "Sandalia Nudo de Maygel, plana con nudo decorativo";
---

<section class="modelo section">
	<div class="container modelo__inner">
		<div class="modelo__media" data-reveal>
			{imagenReferencia ? (
				imagenEsRemota ? (
					<Image
						src={imagenReferencia}
						alt={altReferencia}
						width={900}
						height={563}
						widths={[450, 900, 1350]}
						sizes="(min-width: 900px) 45vw, 100vw"
						format="webp"
						loading="lazy"
					/>
				) : (
					<img src={imagenReferencia} alt={altReferencia} width="900" height="563" loading="lazy" decoding="async" />
				)
			) : (
				<div class="modelo__visual" role="img" aria-label="Sandalias Maygel — fotografía próximamente"></div>
			)}
		</div>

		<div class="modelo__texto" data-reveal>
			<h2 class="section-title modelo__titulo">¿Tienes un diseño en mente?</h2>
			<p class="modelo__parrafo">
				Envíanos una foto o referencia por WhatsApp. Revisamos el diseño y te confirmamos si es
				posible fabricarlo.
			</p>
			<a class="btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
				Consultar por WhatsApp
			</a>
		</div>
	</div>
</section>

<style>
	/* Cierre editorial antes del footer, no otra pantalla completa: padding
	   propio, más corto que el resto de secciones (.section). */
	.modelo--compacto {
		padding-block: clamp(3rem, 6.5vw, 4.5rem);
	}

	.modelo__inner {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}

	.modelo__media {
		width: 100%;
		aspect-ratio: 16 / 10;
		max-height: clamp(260px, 34vw, 460px);
		overflow: hidden;
		border-radius: var(--radius);
		/* Superficie clara a propósito, aunque la sección sea oscura: si la
		   imagen de referencia no resuelve, este bloque debe leerse como una
		   superficie vacía distinta del fondo, nunca fundirse con la sección
		   oscura en una sola masa sin contenido. */
		background-color: var(--color-surface);
	}

	.modelo__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}

	/* Fallback si el producto de referencia no existe o su imagen no carga —
	   nunca vuelve a ser un gradiente de pantalla completa, y nunca del mismo
	   color que la sección oscura que lo rodea. */
	.modelo__visual {
		width: 100%;
		height: 100%;
		background-color: var(--color-surface);
	}

	.modelo__texto {
		max-width: 44ch;
	}

	.modelo__titulo {
		margin-bottom: 1.25rem;
	}

	.modelo__parrafo {
		color: var(--color-text);
		margin-bottom: 2rem;
		max-width: 42ch;
	}

	@media (min-width: 900px) {
		.modelo__inner {
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: clamp(3rem, 6vw, 5rem);
		}
	}
</style>
