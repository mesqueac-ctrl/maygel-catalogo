---
import { buildWhatsappLink, MENSAJE_AYUDA } from "../consts";

const pasos = [
	{
		numero: "1",
		titulo: "Elige modelo y color",
		// Fase 13.3 §10: no existe un rango de tallas publicado — fabricamos
		// según la talla que indica la clienta ("Según pedido" en cada PDP).
		// "Revisa las tallas disponibles" sugería una lista que no existe.
		texto: "Mira el catálogo y elige tu color preferido.",
	},
	{
		numero: "2",
		titulo: "Escríbenos por WhatsApp",
		texto: "Te confirmamos disponibilidad y te asesoramos para elegir la talla ideal.",
	},
	{
		numero: "3",
		titulo: "Fabricación y entrega",
		texto:
			"La confección artesanal de tu sandalia inicia tras confirmar tu pedido y talla. Coordinamos entrega y pago.",
	},
];

// Fase 11.1: se retiró "Hecho bajo pedido" de esta lista — la misma idea ya
// se dice en el Manifiesto, el Hero y el tag de cada PDP; repetirla aquí
// solo alargaba la sección sin información nueva.
const confianza = [
	{
		titulo: "Cambios",
		texto: "Por talla, detalles o defectos. El envío del cambio se cobra de nuevo.",
	},
	{
		titulo: "Atención directa",
		texto: "Hablas con nosotros por WhatsApp, sin intermediarios ni respuestas automáticas.",
	},
];

// Ayuda visible (Fase 8.3): mensaje propio, distinto de "duda de compra",
// para que Maygel identifique que viene del bloque de ayuda de la home.
const whatsappAyuda = buildWhatsappLink(MENSAJE_AYUDA);
---

<section class="comprar comprar--compacto" id="como-comprar">
	<div class="container">
		<header class="comprar__header" data-reveal>
			<h2 class="section-title">Así trabajamos</h2>
		</header>

		<ol class="pasos">
			{
				pasos.map((paso) => (
					<li class="paso">
						<span class="paso__numero">{paso.numero}</span>
						<h3 class="paso__titulo">{paso.titulo}</h3>
						<p class="paso__texto">{paso.texto}</p>
					</li>
				))
			}
		</ol>

		<div class="confianza">
			{
				confianza.map((item) => (
					<div class="confianza__item">
						<h3 class="confianza__titulo">{item.titulo}</h3>
						<p class="confianza__texto">{item.texto}</p>
					</div>
				))
			}
		</div>

		<p class="ayuda-visible" data-reveal>
			¿Necesitas ayuda para elegir o pedir tu par?{" "}
			<a href={whatsappAyuda} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>.
		</p>

		<p class="comprar__logistica">
			Entregamos en Soledad (con pago contraentrega) y Barranquilla (domicilio a cargo de la
			clienta, entre $10.000 y $15.000 COP). En Cartagena solo atendemos pedidos al por mayor. Pagos
			con Nequi, Bancolombia, Llave, efectivo o contraentrega.
			{" "}
			<a href="/ayuda">Ver la guía completa de ayuda</a>.
		</p>
	</div>
</section>

<style>
	.comprar {
		border-top: 1px solid var(--color-line);
	}

	.comprar--compacto {
		padding-block: clamp(3rem, 6.5vw, 4.5rem);
	}

	.comprar__header {
		margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
	}

	.pasos {
		list-style: none;
		margin: 0 0 clamp(2rem, 4.5vw, 3rem);
		padding: 0;
		display: grid;
		gap: clamp(1.75rem, 3.5vw, 2.25rem);
	}

	.paso__numero {
		display: block;
		font-family: var(--font-body);
		font-weight: 600;
		font-variant-numeric: lining-nums tabular-nums;
		font-size: clamp(2.25rem, 4.5vw, 2.75rem);
		line-height: 1;
		color: var(--color-accent);
		margin-bottom: 0.75rem;
	}

	.paso__titulo {
		font-size: 1.1875rem;
		margin-bottom: 0.5rem;
	}

	.paso__texto {
		color: var(--color-muted);
		max-width: 34ch;
	}

	.confianza {
		margin: 0;
		padding-top: clamp(1.75rem, 3.5vw, 2.25rem);
		border-top: 1px solid var(--color-line);
		display: grid;
		gap: 1.5rem;
	}

	.confianza__titulo {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.confianza__texto {
		margin: 0;
		color: var(--color-muted);
		max-width: 36ch;
	}

	/* Fase 11.1: compactada a una sola línea + CTA discreto en el mismo
	   renglón — antes era una caja independiente (título + texto + botón)
	   que repetía lo que el CTA de cada PDP ya resuelve. */
	.ayuda-visible {
		margin-top: clamp(2rem, 4vw, 2.5rem);
		font-size: 1.0625rem;
		color: var(--color-text);
		max-width: 52ch;
	}

	.ayuda-visible a {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.ayuda-visible a:hover {
		color: var(--color-accent-hover);
	}

	.comprar__logistica {
		margin-top: clamp(1.75rem, 3.5vw, 2.25rem);
		color: var(--color-muted);
		max-width: 62ch;
	}

	.comprar__logistica a {
		color: var(--color-text);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 2px;
		transition: color 0.2s ease;
	}

	.comprar__logistica a:hover {
		color: var(--color-accent);
	}

	@media (min-width: 700px) {
		.pasos {
			grid-template-columns: repeat(3, 1fr);
		}

		.confianza {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem 3rem;
			max-width: 60ch;
		}
	}
</style>
