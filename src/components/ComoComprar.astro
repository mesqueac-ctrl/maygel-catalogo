---
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL } from "../consts";

const pasos = [
	{
		titulo: "Elige tu modelo",
		texto: "Mira la colección y escoge tu color.",
	},
	{
		titulo: "Escríbenos",
		texto: "Te ayudamos con la talla por WhatsApp.",
	},
	{
		titulo: "Lo hacemos para ti",
		texto: "Fabricamos tu par y coordinamos entrega y pago.",
	},
];

const etiquetas = [
	{
		label: "Contraentrega en Soledad",
		icon: "pin",
	},
	{
		label: "Cambios por talla",
		icon: "swap",
	},
	{
		label: "Atención directa",
		icon: "chat",
	},
];

const whatsapp = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
---

<section class="comprar section" id="como-comprar">
	<div class="container">
		<header data-reveal>
			<h2 class="section-title">Cómo comprar</h2>
		</header>

		<ol class="pasos">
			{
				pasos.map((paso, i) => (
					<li class="paso">
						<span class="paso__n" aria-hidden="true">
							{String(i + 1).padStart(2, "0")}
						</span>
						<div>
							<h3>{paso.titulo}</h3>
							<p>{paso.texto}</p>
						</div>
					</li>
				))
			}
		</ol>

		<p class="comprar__cta">
			<a class="btn" href={whatsapp} target="_blank" rel="noopener noreferrer">
				Pedir por WhatsApp
			</a>
		</p>

		<ul class="etiquetas">
			{
				etiquetas.map((item) => (
					<li>
						{item.icon === "pin" && (
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									fill="currentColor"
									d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
								/>
							</svg>
						)}
						{item.icon === "swap" && (
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									fill="currentColor"
									d="M7 7h11l-2.2-2.2 1.4-1.4L21.8 8 17.2 12.6l-1.4-1.4L18 9H7V7Zm10 10H6l2.2 2.2-1.4 1.4L2.2 16 6.8 11.4l1.4 1.4L6 15h11v2Z"
								/>
							</svg>
						)}
						{item.icon === "chat" && (
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									fill="currentColor"
									d="M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H8l-4 4v-4H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"
								/>
							</svg>
						)}
						<span>{item.label}</span>
					</li>
				))
			}
		</ul>

		<details class="politicas">
			<summary>Ver envíos, pagos y cambios</summary>
			<div class="politicas__cuerpo">
				<p>Te confirmamos el tiempo de entrega por WhatsApp.</p>
				<p>Por talla, detalles o defectos. El envío del cambio se cobra de nuevo.</p>
				<p>
					Entregamos en Soledad (con pago contraentrega) y Barranquilla (domicilio a cargo de la
					clienta, entre $10.000 y $15.000 COP). En Cartagena solo atendemos pedidos al por mayor.
					Pagos con Nequi, Bancolombia, Llave, efectivo o contraentrega.
				</p>
				<p>
					<a href="/ayuda#tallas">Consulta tu talla</a>
					{" · "}
					<a href="/ayuda">Ver la guía completa de ayuda</a>.
				</p>
			</div>
		</details>
	</div>
</section>

<style>
	.comprar {
		background: var(--color-surface);
	}

	.pasos {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.85rem;
	}

	.paso {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr);
		gap: 0.75rem;
		align-items: start;
		padding: 0;
		background: none;
	}

	.paso__n {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.05rem;
		letter-spacing: -0.04em;
		color: var(--color-cta);
		line-height: 1.35;
	}

	.paso h3 {
		font-size: 1rem;
		margin-bottom: 0.15rem;
	}

	.paso p {
		color: var(--color-text);
		font-size: 0.9375rem;
		line-height: 1.45;
		max-width: none;
	}

	.comprar__cta {
		margin-top: 1.35rem;
	}

	.etiquetas {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.etiquetas li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-text);
	}

	.etiquetas svg {
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		color: var(--color-cta);
	}

	.politicas {
		margin-top: 1.15rem;
		max-width: 62ch;
	}

	.politicas summary {
		display: flex;
		align-items: center;
		min-height: 44px;
		cursor: pointer;
		font-weight: 600;
		color: var(--color-cta);
		list-style: none;
	}

	.politicas summary::-webkit-details-marker {
		display: none;
	}

	.politicas summary::after {
		content: "+";
		margin-left: 0.45rem;
		font-weight: 700;
	}

	.politicas[open] summary::after {
		content: "–";
	}

	.politicas__cuerpo {
		display: grid;
		gap: 0.75rem;
		padding: 0.15rem 0 0.4rem;
	}

	.politicas__cuerpo p {
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.politicas a {
		color: var(--color-cta);
		font-weight: 600;
	}

	@media (min-width: 768px) {
		.pasos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
		}

		.paso {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}

		.etiquetas {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.85rem;
		}
	}
</style>
