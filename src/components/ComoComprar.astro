---
import { buildWhatsappLink, MENSAJE_AYUDA } from "../consts";

const pasos = [
	{
		numero: "1",
		titulo: "Elige modelo y color",
		texto: "Mira el catálogo, selecciona tu color preferido y revisa las tallas disponibles.",
	},
	{
		numero: "2",
		titulo: "Escríbenos por WhatsApp",
		texto: "Te confirmamos disponibilidad y te asesoramos para elegir la talla ideal.",
	},
	{
		numero: "3",
		titulo: "Fabricación y entrega",
		texto:
			"La confección artesanal de tu sandalia inicia tras confirmar tu pedido y talla. Coordinamos entrega y pago.",
	},
];

const confianza = [
	{
		titulo: "Hecho bajo pedido",
		texto: "Tu sandalia se fabrica especialmente para ti, no antes de que la pidas.",
	},
	{
		titulo: "Cambios",
		texto: "Por talla, detalles o defectos. El envío del cambio se cobra de nuevo.",
	},
	{
		titulo: "Atención directa",
		texto: "Hablas con nosotros por WhatsApp, sin intermediarios ni respuestas automáticas.",
	},
];

// Ayuda visible (Fase 8.3): mensaje propio, distinto de "duda de compra",
// para que Maygel identifique que viene del bloque de ayuda de la home.
const whatsappAyuda = buildWhatsappLink(MENSAJE_AYUDA);
---

<section class="comprar section" id="como-comprar">
	<div class="container">
		<header class="comprar__header" data-reveal>
			<h2 class="section-title">Así trabajamos</h2>
		</header>

		<ol class="pasos">
			{
				pasos.map((paso) => (
					<li class="paso">
						<span class="paso__numero">{paso.numero}</span>
						<h3 class="paso__titulo">{paso.titulo}</h3>
						<p class="paso__texto">{paso.texto}</p>
					</li>
				))
			}
		</ol>

		<div class="confianza">
			{
				confianza.map((item) => (
					<div class="confianza__item">
						<h3 class="confianza__titulo">{item.titulo}</h3>
						<p class="confianza__texto">{item.texto}</p>
					</div>
				))
			}
		</div>

		<div class="ayuda-visible" data-reveal>
			<p class="ayuda-visible__titulo">¿Necesitas ayuda para elegir o pedir tu par?</p>
			<p class="ayuda-visible__texto">Te guiamos paso a paso, sin apuros.</p>
			<a class="btn ayuda-visible__boton" href={whatsappAyuda} target="_blank" rel="noopener noreferrer">
				Escríbenos por WhatsApp
			</a>
		</div>

		<p class="comprar__logistica">
			Entregamos en Soledad (con pago contraentrega) y Barranquilla (domicilio a cargo de la
			clienta, entre $10.000 y $15.000 COP). En Cartagena solo atendemos pedidos al por mayor. Pagos
			con Nequi, Bancolombia, Llave, efectivo o contraentrega.
			{" "}
			<a href="/ayuda">Ver la guía completa de ayuda</a>.
		</p>
	</div>
</section>

<style>
	.comprar {
		border-top: 1px solid var(--color-line);
	}

	.comprar__header {
		margin-bottom: clamp(3rem, 7vw, 4.5rem);
	}

	.pasos {
		list-style: none;
		margin: 0 0 clamp(3.5rem, 8vw, 5.5rem);
		padding: 0;
		display: grid;
		gap: clamp(2.5rem, 5vw, 3rem);
	}

	.paso__numero {
		display: block;
		font-family: var(--font-body);
		font-weight: 600;
		font-variant-numeric: lining-nums tabular-nums;
		font-size: clamp(2.5rem, 5.5vw, 3.25rem);
		line-height: 1;
		color: var(--color-accent);
		margin-bottom: 1rem;
	}

	.paso__titulo {
		font-size: 1.1875rem;
		margin-bottom: 0.5rem;
	}

	.paso__texto {
		color: var(--color-muted);
		max-width: 34ch;
	}

	.confianza {
		margin: 0;
		padding-top: clamp(2.5rem, 5vw, 3rem);
		border-top: 1px solid var(--color-line);
		display: grid;
		gap: 2rem;
	}

	.confianza__titulo {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.confianza__texto {
		margin: 0;
		color: var(--color-muted);
		max-width: 36ch;
	}

	/* Ayuda visible (Fase 8.3): más grande y con más contraste que el resto
	   de la sección a propósito — pensada para alguien que necesita ver la
	   salida a WhatsApp de un vistazo, sin leer todo el bloque de confianza. */
	.ayuda-visible {
		margin-top: clamp(3rem, 6vw, 4rem);
		padding: clamp(1.75rem, 4vw, 2.5rem);
		background-color: var(--color-surface);
		border: 1px solid var(--color-line);
		max-width: 46ch;
	}

	.ayuda-visible__titulo {
		font-family: var(--font-display);
		font-size: clamp(1.375rem, 3vw, 1.75rem);
		font-weight: 600;
		color: var(--color-text);
		margin-bottom: 0.5rem;
	}

	.ayuda-visible__texto {
		color: var(--color-text);
		margin-bottom: 1.25rem;
	}

	.ayuda-visible__boton {
		display: inline-flex;
	}

	.comprar__logistica {
		margin-top: clamp(2.5rem, 5vw, 3rem);
		color: var(--color-muted);
		max-width: 62ch;
	}

	.comprar__logistica a {
		color: var(--color-text);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 2px;
		transition: color 0.2s ease;
	}

	.comprar__logistica a:hover {
		color: var(--color-accent);
	}

	@media (min-width: 700px) {
		.pasos {
			grid-template-columns: repeat(3, 1fr);
		}

		.confianza {
			grid-template-columns: repeat(3, 1fr);
			gap: 2.5rem 3rem;
		}
	}
</style>
