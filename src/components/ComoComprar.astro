---
import { buildWhatsappLink, MENSAJE_DUDA_COMPRA } from "../consts";

const pasos = [
	{
		numero: "1",
		titulo: "Elige modelo y color",
		texto: "Mira el catálogo, selecciona tu color preferido y revisa las tallas disponibles.",
	},
	{
		numero: "2",
		titulo: "Escríbenos por WhatsApp",
		texto: "Te confirmamos disponibilidad y te asesoramos para elegir la talla ideal.",
	},
	{
		numero: "3",
		titulo: "Fabricación y entrega",
		texto:
			"La confección artesanal de tu sandalia inicia tras confirmar tu pedido y talla. Coordinamos entrega y pago.",
	},
];

const confianza = [
	{
		titulo: "Hecho bajo pedido",
		texto: "Tu sandalia se fabrica especialmente para ti, no antes de que la pidas.",
	},
	{
		titulo: "Cambio de talla",
		texto: "Si no queda bien, lo solucionamos. El domicilio del cambio corre por tu cuenta.",
	},
	{
		titulo: "Atención directa",
		texto: "Hablas con nosotros por WhatsApp, sin intermediarios ni respuestas automáticas.",
	},
];

const whatsappLink = buildWhatsappLink(MENSAJE_DUDA_COMPRA);
---

<section class="comprar section" id="como-comprar">
	<div class="container">
		<header class="comprar__header" data-reveal>
			<h2 class="section-title">Así trabajamos</h2>
		</header>

		<ol class="pasos">
			{
				pasos.map((paso) => (
					<li class="paso">
						<span class="paso__numero">{paso.numero}</span>
						<h3 class="paso__titulo">{paso.titulo}</h3>
						<p class="paso__texto">{paso.texto}</p>
					</li>
				))
			}
		</ol>

		<div class="confianza">
			{
				confianza.map((item) => (
					<div class="confianza__item">
						<h3 class="confianza__titulo">{item.titulo}</h3>
						<p class="confianza__texto">{item.texto}</p>
					</div>
				))
			}
		</div>

		<p class="comprar__logistica">
			Entregas en Soledad y Barranquilla; envíos nacionales para pedidos al por mayor. Pago
			contraentrega local, Nequi, Daviplata o transferencia bancaria.
			{" "}
			¿No sabes qué talla pedir?{" "}
			<a href={whatsappLink} target="_blank" rel="noopener noreferrer">Escríbenos y te ayudamos</a>.
		</p>
	</div>
</section>

<style>
	.comprar {
		border-top: 1px solid var(--color-line);
	}

	.comprar__header {
		margin-bottom: clamp(3rem, 7vw, 4.5rem);
	}

	.pasos {
		list-style: none;
		margin: 0 0 clamp(3.5rem, 8vw, 5.5rem);
		padding: 0;
		display: grid;
		gap: clamp(2.5rem, 5vw, 3rem);
	}

	.paso__numero {
		display: block;
		font-family: var(--font-body);
		font-weight: 600;
		font-variant-numeric: lining-nums tabular-nums;
		font-size: clamp(2.5rem, 5.5vw, 3.25rem);
		line-height: 1;
		color: var(--color-accent);
		margin-bottom: 1rem;
	}

	.paso__titulo {
		font-size: 1.1875rem;
		margin-bottom: 0.5rem;
	}

	.paso__texto {
		color: var(--color-muted);
		max-width: 34ch;
	}

	.confianza {
		margin: 0;
		padding-top: clamp(2.5rem, 5vw, 3rem);
		border-top: 1px solid var(--color-line);
		display: grid;
		gap: 2rem;
	}

	.confianza__titulo {
		font-size: 1rem;
		font-weight: 600;
		margin-bottom: 0.5rem;
	}

	.confianza__texto {
		margin: 0;
		color: var(--color-muted);
		max-width: 36ch;
	}

	.comprar__logistica {
		margin-top: clamp(2.5rem, 5vw, 3rem);
		color: var(--color-muted);
		max-width: 62ch;
	}

	.comprar__logistica a {
		color: var(--color-text);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 2px;
		transition: color 0.2s ease;
	}

	.comprar__logistica a:hover {
		color: var(--color-accent);
	}

	@media (min-width: 700px) {
		.pasos {
			grid-template-columns: repeat(3, 1fr);
		}

		.confianza {
			grid-template-columns: repeat(3, 1fr);
			gap: 2.5rem 3rem;
		}
	}
</style>
