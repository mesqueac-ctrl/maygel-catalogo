---
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL, INSTAGRAM_URL, INSTAGRAM_HANDLE } from "../consts";

const whatsappLink = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);

const navLinks = [
	{ href: "#catalogo", label: "Colección" },
	{ href: "#sobre-nosotros", label: "Nuestra historia" },
	{ href: "#como-comprar", label: "Cómo comprar" },
	{ href: "#por-mayor", label: "Mayoristas" },
	// Ayuda y Términos (Fase 8.3): acceso directo desde el footer, punto
	// mínimo de arquitectura pedido para la nueva capa de ayuda visible.
	{ href: "/ayuda", label: "Ayuda" },
	{ href: "/terminos", label: "Términos" },
];
---

<footer class="footer section section--dark" id="contacto">
	<div class="container">
		<p class="footer__brand">Maygel</p>

		<div class="footer__top">
			<h2 class="section-title footer__title">Hablemos</h2>
			<p class="footer__lead">
				¿Tienes dudas sobre tallas, colores o encargos especiales? Escríbenos, con gusto te
				ayudamos.
			</p>
			<a class="btn btn-on-dark" href={whatsappLink} target="_blank" rel="noopener noreferrer">
				Escríbenos por WhatsApp
			</a>
		</div>

		<div class="footer__bottom">
			<nav class="footer__nav" aria-label="Navegación del pie de página">
				{navLinks.map((link) => (
					<a class="footer__link" href={link.href}>{link.label}</a>
				))}
				<a class="footer__link" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
					@{INSTAGRAM_HANDLE}
				</a>
			</nav>

			<p class="footer__copy">© {new Date().getFullYear()} Maygel — Hecho a mano, con familia.</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-line);
		padding-block: clamp(3rem, 7.5vw, 4.5rem) clamp(2.25rem, 5vw, 3rem);
	}

	.footer__brand {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.5rem, 7vw, 4rem);
		letter-spacing: 0.005em;
		margin-bottom: clamp(2rem, 5vw, 3.25rem);
	}

	.footer__top {
		max-width: 46ch;
		margin-bottom: clamp(2.5rem, 5.5vw, 3.75rem);
	}

	.footer__title {
		margin-bottom: 1.25rem;
	}

	.footer__lead {
		color: rgba(244, 236, 225, 0.7);
		margin-bottom: 2rem;
	}

	.footer__bottom {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-dark-line);
	}

	.footer__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	.footer__link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
		font-size: 0.875rem;
		color: rgba(244, 236, 225, 0.65);
		transition: color 0.2s ease;
	}

	.footer__link:hover {
		color: var(--color-champagne);
	}

	.footer__copy {
		font-size: 0.8125rem;
		color: rgba(244, 236, 225, 0.45);
	}

	@media (min-width: 700px) {
		.footer__bottom {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
