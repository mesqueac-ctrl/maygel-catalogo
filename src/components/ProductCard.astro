---
import { Image } from "astro:assets";
import { buildWhatsappLink } from "../consts";
import { formatearPrecio, tallasComoLista, type ProductoRegistro } from "../lib/productos";

interface Props {
	producto: ProductoRegistro;
}

const { producto } = Astro.props;

const precioFormateado = formatearPrecio(producto.precio);
const tallas = tallasComoLista(producto.tallas);
const whatsappLink = buildWhatsappLink(`Hola, me interesa ${producto.nombre}`);

// Las fotos subidas desde el panel son URLs remotas (Vercel Blob) y las optimiza
// <Image>. Las que viven en /public se sirven tal cual.
const esRemota = producto.imagen.startsWith("http");
---

<article class="card">
	<div class="card__image">
		{
			esRemota ? (
				<Image src={producto.imagen} alt={producto.nombre} width={800} height={1000} />
			) : (
				<img src={producto.imagen} alt={producto.nombre} width="800" height="1000" loading="lazy" />
			)
		}
	</div>

	<div class="card__body">
		<h3 class="card__name">{producto.nombre}</h3>
		<p class="card__price">{precioFormateado}</p>
		<p class="card__description">{producto.descripcion}</p>
		{tallas.length > 0 && <p class="card__sizes">Tallas {tallas.join(" · ")}</p>}

		<a class="card__cta" href={whatsappLink} target="_blank" rel="noopener noreferrer">
			Consultar por WhatsApp
		</a>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
	}

	.card__image {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background-color: #f2ece4;
		margin-bottom: 1.5rem;
	}

	.card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.card:hover .card__image :global(img) {
		transform: scale(1.03);
	}

	.card__name {
		font-size: 1.25rem;
		margin-bottom: 0.35rem;
	}

	.card__price {
		font-size: 0.9375rem;
		color: var(--color-accent);
		margin-bottom: 0.85rem;
	}

	.card__description {
		font-size: 0.9375rem;
		font-weight: 300;
		color: var(--color-accent-soft);
		margin-bottom: 0.85rem;
	}

	.card__sizes {
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		color: var(--color-accent-soft);
		margin-bottom: 1.5rem;
	}

	.card__cta {
		align-self: flex-start;
		margin-top: auto;
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-decoration: none;
		color: var(--color-text);
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 3px;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.card__cta:hover {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}
</style>
