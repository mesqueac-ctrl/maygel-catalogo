---
import { Image } from "astro:assets";
import {
	formatearPrecio,
	precioEfectivo,
	tieneDescuento,
	coloresComoLista,
	descripcionImagen,
	imagenParaColor,
	imagenesColoresComoMapa,
	COLORES_METADATA,
	type ProductoRegistro,
} from "../lib/productos";
import { enlaceProducto } from "../lib/whatsapp";

interface Props {
	producto: ProductoRegistro;
}

const { producto } = Astro.props;
const urlFicha = `/productos/${producto.slug}`;
const paginaAbsoluta = new URL(urlFicha, Astro.url.origin).href;

const hayDescuento = tieneDescuento(producto);
const precioActual = formatearPrecio(precioEfectivo(producto));
const precioAnterior = hayDescuento ? formatearPrecio(producto.precio) : null;
const colores = coloresComoLista(producto.colores);
const unicoColor = colores.length === 1 ? colores[0] : null;
const imagen = imagenParaColor(producto, unicoColor);
const mapa = imagenesColoresComoMapa(producto.imagenesColores);
const hoverImagen = Object.values(mapa).find((url) => url && url !== imagen) ?? null;
const esRemota = imagen.startsWith("http");
const hoverRemota = hoverImagen?.startsWith("http") ?? false;
const altImagen = descripcionImagen(producto.nombre);
const pedirHref = enlaceProducto(producto.nombre, unicoColor, paginaAbsoluta, null, precioActual);
---

<article class="card">
	<a class="card__media" href={urlFicha}>
		{
			esRemota ? (
				<Image
					src={imagen}
					alt={altImagen}
					width={800}
					height={1000}
					widths={[400, 800]}
					sizes="(min-width: 1200px) 22vw, (min-width: 768px) 30vw, 45vw"
					format="webp"
					loading="lazy"
					class="card__foto card__foto--a"
				/>
			) : (
				<img class="card__foto card__foto--a" src={imagen} alt={altImagen} width="800" height="1000" loading="lazy" decoding="async" />
			)
		}
		{
			hoverImagen &&
				(hoverRemota ? (
					<Image
						src={hoverImagen}
						alt=""
						width={800}
						height={1000}
						widths={[400, 800]}
						sizes="(min-width: 1200px) 22vw, (min-width: 768px) 30vw, 45vw"
						format="webp"
						loading="lazy"
						class="card__foto card__foto--b"
					/>
				) : (
					<img class="card__foto card__foto--b" src={hoverImagen} alt="" width="800" height="1000" loading="lazy" decoding="async" />
				))
		}
	</a>

	<div class="card__body">
		<h3 class="card__name">
			<a href={urlFicha}>{producto.nombre}</a>
		</h3>
		<p class="card__price">
			{precioAnterior && <span class="card__price-anterior">{precioAnterior}</span>}
			<span>{precioActual}</span>
		</p>
		{
			colores.length > 0 && (
				<div class="card__colors" role="img" aria-label={`Colores disponibles: ${colores.join(", ")}`}>
					{colores.map((color) => {
						const meta = COLORES_METADATA[color];
						return (
							<span
								class="card__color-dot"
								style={`background-color: ${meta.hex}; border-color: ${meta.border};`}
								title={meta.nombre}
								aria-hidden="true"
							/>
						);
					})}
				</div>
			)
		}
		<a class="btn-outline card__pedir" href={pedirHref} target="_blank" rel="noopener noreferrer">
			Pedir
		</a>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-width: 0;
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow: visible;
		box-shadow: 0 10px 28px rgba(43, 26, 18, 0.08);
	}

	.card__media {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius) var(--radius) 0 0;
		background: var(--color-image-fallback);
	}

	.card__foto {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.35s ease, transform 0.5s ease;
	}

	.card__foto--b {
		position: absolute;
		inset: 0;
		opacity: 0;
	}

	.card:hover .card__foto--b {
		opacity: 1;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.65rem 0.6rem 0.8rem;
		min-width: 0;
	}

	.card__name {
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: none;
		line-height: 1.3;
		overflow-wrap: break-word;
	}

	.card__name a {
		color: inherit;
		text-decoration: none;
		text-transform: none;
	}

	.card__price {
		font-variant-numeric: lining-nums tabular-nums;
		font-weight: 600;
		font-size: 0.8125rem;
		color: var(--color-text);
	}

	.card__price-anterior {
		text-decoration: line-through;
		color: var(--color-muted);
		margin-right: 0.4rem;
		font-weight: 500;
	}

	.card__colors {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.28rem;
		min-height: 16px;
		overflow: visible;
	}

	.card__color-dot {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 1.5px solid;
		flex-shrink: 0;
	}

	.card__pedir {
		align-self: flex-start;
		margin-top: 0.25rem;
		min-height: 44px;
		padding: 0.35rem 0.8rem;
		font-size: 0.75rem;
		box-shadow: none;
		width: auto;
		max-width: 100%;
	}

	@media (min-width: 768px) {
		.card__body {
			gap: 0.4rem;
			padding: 0.9rem 0.9rem 1.05rem;
		}

		.card__name {
			font-size: 1rem;
			overflow-wrap: break-word;
		}

		.card__price {
			font-size: 1rem;
		}

		.card__color-dot {
			width: 18px;
			height: 18px;
		}

		.card__pedir {
			padding: 0.45rem 1rem;
			font-size: 0.8125rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card__foto,
		.card:hover .card__foto--a {
			transition: none;
			transform: none;
		}
	}
</style>
