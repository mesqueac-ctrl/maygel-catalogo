---
import { Image } from "astro:assets";
import {
	formatearPrecio,
	coloresComoLista,
	descripcionImagen,
	imagenParaColor,
	COLORES_METADATA,
	type ProductoRegistro,
} from "../lib/productos";

// Fase 5: la ficha de producto (variante "ficha" de versiones anteriores) se
// reescribió como una página propia — ver src/pages/productos/[slug].astro.
// Este componente ahora sirve un único propósito: la tarjeta compacta de
// catálogo/destacados. Foto + nombre + precio + color, sin más — la tarjeta
// completa es un enlace ("stretched link").
interface Props {
	producto: ProductoRegistro;
}

const { producto } = Astro.props;
const urlFicha = `/productos/${producto.slug}`;

const precioFormateado = formatearPrecio(producto.precio);
const colores = coloresComoLista(producto.colores);
const unicoColor = colores.length === 1 ? colores[0] : null;
const imagen = imagenParaColor(producto, unicoColor);
const esRemota = imagen.startsWith("http");
const altImagen = descripcionImagen(producto.nombre);
---

<article class="card">
	<div class="card__image">
		{producto.destacado && <span class="card__destacado">Selección</span>}
		{
			esRemota ? (
				<Image
					src={imagen}
					alt={altImagen}
					width={800}
					height={1000}
					widths={[400, 800, 1200]}
					sizes="(min-width: 1000px) 30vw, (min-width: 480px) 45vw, 90vw"
					format="webp"
					loading="lazy"
				/>
			) : (
				<img src={imagen} alt={altImagen} width="800" height="1000" loading="lazy" decoding="async" />
			)
		}
	</div>

	<div class="card__body">
		<div class="card__header">
			<h3 class="card__name">
				<a class="card__link" href={urlFicha}>{producto.nombre}</a>
			</h3>
			<p class="card__price">{precioFormateado}</p>
		</div>

		{
			colores.length > 0 && (
				<div class="card__colors" role="img" aria-label={`Colores disponibles: ${colores.join(", ")}`}>
					{colores.map((color) => {
						const meta = COLORES_METADATA[color];
						return (
							<span
								class="card__color-dot"
								style={`background-color: ${meta.hex}; border-color: ${meta.border};`}
								aria-hidden="true"
							/>
						);
					})}
				</div>
			)
		}
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		position: relative;
	}

	/* La tarjeta completa es clicable: el enlace visible es solo el nombre,
	   pero su pseudo-elemento se extiende sobre toda la tarjeta ("stretched
	   link") — evita duplicar el mismo enlace en imagen + nombre. */
	.card__link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.card__image {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background-color: #ede4d6;
		margin-bottom: 1.1rem;
	}

	.card__destacado {
		position: absolute;
		top: 0.9rem;
		left: 0.9rem;
		z-index: 1;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-dark-text);
	}

	.card__image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.card:hover .card__image :global(img) {
		transform: scale(1.02);
	}

	.card__body {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.card__header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.4rem;
	}

	.card__name {
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.card__link {
		color: inherit;
		text-decoration: none;
	}

	.card__link:hover {
		color: var(--color-accent);
	}

	.card__price {
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.card__colors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.card__color-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: 1px solid;
		flex-shrink: 0;
	}
</style>
