---
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL } from "../consts";

const navLinks = [
	{ href: "/#catalogo", label: "Colección" },
	{ href: "/#sobre-nosotros", label: "Nuestra historia" },
	{ href: "/#como-comprar", label: "Cómo comprar" },
	{ href: "/#por-mayor", label: "Mayoristas" },
];

const whatsappLink = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
---

<header class="header" id="header">
	<div class="container header__inner">
		<a href="/#inicio" class="header__brand">Maygel</a>

		<nav class="header__nav" aria-label="Navegación principal">
			{navLinks.map((link) => (
				<a href={link.href}>{link.label}</a>
			))}
		</nav>

		<div class="header__actions">
			<a class="header__cta" href={whatsappLink} target="_blank" rel="noopener noreferrer">
				Pedir por WhatsApp
			</a>

			<button
				type="button"
				class="header__toggle"
				id="header-toggle"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="menu-movil"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
</header>

<div class="menu-movil" id="menu-movil" hidden>
	<nav class="menu-movil__nav" aria-label="Navegación móvil">
		<ul>
			{navLinks.map((link) => (
				<li><a href={link.href}>{link.label}</a></li>
			))}
		</ul>
	</nav>

	<a class="btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
		Pedir por WhatsApp
	</a>
</div>

<script>
	const boton = document.getElementById("header-toggle");
	const menu = document.getElementById("menu-movil");
	const header = document.getElementById("header");
	const contenidoDeFondo = document.querySelectorAll<HTMLElement>("main, .footer");

	function abrirMenu() {
		if (!menu || !boton) return;
		menu.hidden = false;
		boton.setAttribute("aria-expanded", "true");
		boton.setAttribute("aria-label", "Cerrar menú");
		document.body.style.overflow = "hidden";
		contenidoDeFondo.forEach((el) => el.setAttribute("inert", ""));
		menu.querySelector("a")?.focus();
	}

	function cerrarMenu(devolverFoco = true) {
		if (!menu || !boton) return;
		menu.hidden = true;
		boton.setAttribute("aria-expanded", "false");
		boton.setAttribute("aria-label", "Abrir menú");
		document.body.style.overflow = "";
		contenidoDeFondo.forEach((el) => el.removeAttribute("inert"));
		if (devolverFoco) boton.focus();
	}

	boton?.addEventListener("click", () => {
		const abierto = boton.getAttribute("aria-expanded") === "true";
		if (abierto) cerrarMenu();
		else abrirMenu();
	});

	menu?.querySelectorAll("a").forEach((enlace) => {
		enlace.addEventListener("click", () => cerrarMenu(false));
	});

	document.addEventListener("keydown", (evento) => {
		if (evento.key === "Escape" && boton?.getAttribute("aria-expanded") === "true") {
			cerrarMenu();
		}
	});

	function actualizarScroll() {
		if (!header) return;
		header.classList.toggle("header--con-scroll", window.scrollY > 12);
	}

	actualizarScroll();
	window.addEventListener("scroll", actualizarScroll, { passive: true });
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.85rem;
	}

	.header__brand {
		font-family: var(--font-display);
		font-size: 1.55rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		text-decoration: none;
		line-height: 1;
	}

	.header__nav {
		display: none;
		gap: 1.5rem;
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.header__nav a {
		text-decoration: none;
		color: var(--color-text);
	}

	.header__nav a:hover {
		color: var(--color-cta);
	}

	.header__actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.header__cta {
		display: none;
		align-items: center;
		min-height: 44px;
		padding: 0.5rem 1.1rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-cta);
		color: #fff;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
	}

	.header__cta:hover {
		background-color: var(--color-cta-hover);
	}

	.header__toggle {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 44px;
		height: 44px;
		background: transparent;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.header__toggle span {
		display: block;
		height: 2px;
		width: 22px;
		background-color: var(--color-text);
		border-radius: 99px;
	}

	.menu-movil {
		position: fixed;
		inset: 0;
		z-index: 60;
		background-color: var(--color-bg);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 6rem 1.5rem 2.5rem;
	}

	.menu-movil[hidden] {
		display: none;
	}

	.menu-movil__nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.menu-movil__nav a {
		display: flex;
		align-items: center;
		min-height: 52px;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 8vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		text-decoration: none;
	}

	@media (min-width: 780px) {
		.header__nav,
		.header__cta {
			display: flex;
		}

		.header__toggle,
		.menu-movil {
			display: none;
		}
	}
</style>
