---
import { buildWhatsappLink, MENSAJE_MAYORISTA } from "../consts";

const whatsappLink = buildWhatsappLink(MENSAJE_MAYORISTA);

const beneficios = [
	{
		titulo: "Pedidos por volumen",
		texto: "Escríbenos y te contamos condiciones y precios según la cantidad que necesites.",
	},
	{
		titulo: "Combina colores",
		texto: "Posibilidad de combinar nuestras variantes de color (Negro, Blanco, Miel, Beige, Café y Plateado) en tu pedido.",
	},
	{
		titulo: "Fabricación bajo pedido",
		texto:
			"Cada lote se elabora a mano especialmente para tu negocio. Los pedidos mayoristas deben realizarse con anticipación.",
	},
];
---

<section class="mayor section section--surface" id="por-mayor">
	<div class="container mayor__inner">
		<div class="mayor__content" data-reveal>
			<h2 class="section-title mayor__title">Venta al por mayor</h2>
			<p class="mayor__lead">
				Lleva nuestras sandalias planas artesanales a tu boutique o proyecto comercial.
				Fabricamos bajo pedido, a mano, en nuestro taller familiar.
			</p>

			<div class="mayor__puntos">
				{
					beneficios.map((punto) => (
						<div class="mayor__punto">
							<h3 class="mayor__punto-titulo">{punto.titulo}</h3>
							<p class="mayor__punto-texto">{punto.texto}</p>
						</div>
					))
				}
			</div>

			<div class="mayor__cta-wrapper">
				<a class="btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
					Consultar condiciones mayoristas
				</a>
				<p class="mayor__nota">
					Te dejamos el mensaje listo para que solo completes tu nombre, ciudad, negocio y qué te
					interesa. Así te respondemos con la información justa que necesitas.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.mayor {
		border-top: 1px solid var(--color-line);
		scroll-margin-top: 5rem;
	}

	.mayor__inner {
		max-width: 900px;
	}

	.mayor__title {
		margin-bottom: 1.25rem;
	}

	.mayor__lead {
		font-size: 1.0625rem;
		color: var(--color-muted);
		line-height: 1.7;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
		max-width: 58ch;
	}

	.mayor__puntos {
		display: grid;
		gap: 2rem;
		padding-top: clamp(2rem, 4vw, 2.5rem);
		border-top: 1px solid var(--color-line);
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.mayor__punto-titulo {
		font-size: 1.125rem;
		font-weight: 600;
		margin-bottom: 0.4rem;
	}

	.mayor__punto-texto {
		font-size: 0.9375rem;
		color: var(--color-muted);
		line-height: 1.6;
		max-width: 54ch;
	}

	.mayor__cta-wrapper {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
	}

	.mayor__nota {
		font-size: 0.8125rem;
		color: var(--color-muted);
		max-width: 48ch;
	}

	@media (min-width: 768px) {
		.mayor__puntos {
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
		}
	}
</style>
