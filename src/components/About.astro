---
import { Image } from "astro:assets";
import { fotoDeApoyo } from "../lib/productos";
import { SEO_PRODUCTO } from "../consts";

const apoyo = await fotoDeApoyo(["deriva", "luna"]);
const imagenReferencia = apoyo?.imagen ?? null;
const imagenEsRemota = imagenReferencia?.startsWith("http") ?? false;
const altReferencia = SEO_PRODUCTO.deriva?.alt ?? apoyo?.alt ?? "Sandalia Deriva de Maygel, plana con tira fina diagonal";
---

<section class="about section" id="sobre-nosotros">
	<div class="container about__inner">
		<div class="about__media" data-reveal>
			{
				imagenReferencia ? (
					imagenEsRemota ? (
						<Image
							src={imagenReferencia}
							alt={altReferencia}
							width={900}
							height={1125}
							widths={[450, 900]}
							sizes="(min-width: 900px) 45vw, 100vw"
							format="webp"
							loading="lazy"
						/>
					) : (
						<img src={imagenReferencia} alt={altReferencia} width="900" height="1125" loading="lazy" decoding="async" />
					)
				) : (
					<div class="about__visual" role="img" aria-label="Sandalias Maygel — fotografía próximamente"></div>
				)
			}
		</div>
		<div class="about__text" data-reveal>
			<!-- TODO: contenido provisional — reemplazar con la historia real de Maygel -->
			<h2 class="section-title">Maygel nació en la mesa de nuestra casa.</h2>
			<p>
				Entre materiales, herramientas y las manos de toda la familia. Empezamos haciendo
				sandalias para nosotros mismos, y con el tiempo amigos y vecinos empezaron a pedirnos un
				par. Hoy seguimos haciendo cada sandalia como si fuera la primera: a mano, bajo pedido y
				con cariño por lo que hacemos. Somos un taller familiar en Soledad, con entregas en
				Soledad y Barranquilla.
			</p>
		</div>
	</div>
</section>

<style>
	.about__inner {
		display: grid;
		gap: 1.5rem;
	}

	.about__media,
	.about__visual {
		border-radius: var(--radius);
		overflow: hidden;
		aspect-ratio: 4 / 5;
		max-height: 460px;
		background: var(--color-image-fallback);
	}

	.about__media :global(img),
	.about__visual {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.about__text p {
		margin-top: 1rem;
		color: var(--color-text);
		max-width: 46ch;
		font-size: 1.0625rem;
	}

	@media (min-width: 900px) {
		.about__inner {
			grid-template-columns: 1fr 1.1fr;
			align-items: center;
			gap: 3rem;
		}
	}
</style>
