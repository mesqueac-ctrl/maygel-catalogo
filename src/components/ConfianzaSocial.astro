---
/**
 * Espacio preparado para fotos y frases de clientas reales.
 * Mientras `testimonios` esté vacío, la sección no se renderiza:
 * ningún placeholder llega a producción.
 */
interface Testimonio {
	nombre: string;
	texto: string;
	imagen?: string;
	alt?: string;
}

const testimonios: Testimonio[] = [];
---

{
	testimonios.length > 0 && (
		<section class="confianza-social section" id="clientas" aria-labelledby="confianza-social-titulo">
			<div class="container">
				<header class="confianza-social__header" data-reveal>
					<h2 class="section-title" id="confianza-social-titulo">Lo que cuentan quienes las llevan</h2>
				</header>
				<ul class="confianza-social__lista">
					{testimonios.map((item) => (
						<li class="confianza-social__item">
							{item.imagen && (
								<img src={item.imagen} alt={item.alt ?? ""} width="800" height="1000" loading="lazy" />
							)}
							<blockquote>
								<p>{item.texto}</p>
								<footer>{item.nombre}</footer>
							</blockquote>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.confianza-social {
		border-top: 1px solid var(--color-line);
	}

	.confianza-social__header {
		margin-bottom: var(--space-2xl);
		max-width: 50ch;
	}

	.confianza-social__lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-xl);
	}

	.confianza-social__item img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		margin-bottom: 1rem;
		background-color: var(--color-image-fallback, #c5cdc4);
	}

	.confianza-social__item blockquote {
		margin: 0;
	}

	.confianza-social__item p {
		font-family: var(--font-display);
		font-size: clamp(1.125rem, 2vw, 1.375rem);
		line-height: 1.4;
		max-width: 36ch;
	}

	.confianza-social__item footer {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	@media (min-width: 768px) {
		.confianza-social__lista {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
