---
import "../styles/global.css";

interface Props {
	titulo: string;
	mostrarBarra?: boolean;
}

const { titulo, mostrarBarra = true } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#B5651D" />
		<title>{titulo} · Maygel</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Inter:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		{
			mostrarBarra && (
				<header class="barra">
					<div class="barra__inner">
						<a class="barra__marca" href="/admin/productos">
							Maygel <span>· Panel</span>
						</a>

						<div class="barra__acciones">
							<a class="barra__link" href="/admin/vista-previa">Cómo se ve</a>

							<a class="barra__link" href="/" target="_blank" rel="noopener noreferrer">
								Ver mi página
							</a>

							<form method="POST" action="/admin/api/logout">
								<button class="barra__salir" type="submit">Cerrar sesión</button>
							</form>
						</div>
					</div>
				</header>
			)
		}

		<main class="contenido">
			<slot />
		</main>
	</body>
</html>

<style>
	body {
		background-color: #ffffff;
	}

	.barra {
		background-color: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
		position: sticky;
		top: 0;
		z-index: 10;
	}

	.barra__inner {
		max-width: 1000px;
		margin: 0 auto;
		padding: 1.25rem clamp(1.25rem, 4vw, 2.5rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.barra__marca {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		text-decoration: none;
		color: var(--color-text);
	}

	.barra__marca span {
		color: var(--color-accent-soft);
		font-family: var(--font-body);
		font-size: 0.875rem;
	}

	.barra__acciones {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.barra__link {
		font-size: 0.9375rem;
		color: var(--color-accent-soft);
		text-decoration: none;
		white-space: nowrap;
	}

	.barra__link:hover {
		color: var(--color-text);
	}

	.barra__salir {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 500;
		padding: 0.7rem 1.25rem;
		background-color: transparent;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		cursor: pointer;
	}

	.barra__salir:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	@media (max-width: 520px) {
		.barra__inner {
			padding-block: 1rem;
		}

		.barra__acciones {
			width: 100%;
			justify-content: space-between;
			gap: 0.75rem;
		}

		.barra__salir {
			padding: 0.6rem 1rem;
			font-size: 0.875rem;
		}
	}

	.contenido {
		max-width: 1000px;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 3.5rem) clamp(1.25rem, 4vw, 2.5rem) 5rem;
	}
</style>
