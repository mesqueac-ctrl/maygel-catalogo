---
import "../styles/global.css";

interface Props {
	titulo: string;
	mostrarBarra?: boolean;
}

const { titulo, mostrarBarra = true } = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/png" href="/favicon.png?v=9" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=9" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico?v=9" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=9" />
		<meta name="theme-color" content="#C24520" />
		<title>{titulo} · Maygel</title>

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="admin">
		{
			mostrarBarra && (
				<header class="barra">
					<div class="barra__inner">
						<a class="barra__marca" href="/admin/productos">
							Maygel <span>Panel</span>
						</a>
						<nav class="barra__acciones" aria-label="Panel">
							<a class="barra__link" href="/admin/vista-previa">Cómo se ve</a>
							<a class="barra__link" href="/" target="_blank" rel="noopener noreferrer">
								Ver mi página
							</a>
							<form method="POST" action="/admin/api/logout">
								<button class="barra__salir" type="submit">Salir</button>
							</form>
						</nav>
					</div>
				</header>
			)
		}
		<main class="contenido">
			<slot />
		</main>
	</body>
</html>

<style>
	body.admin {
		--color-bg: #f6efe6;
		--color-surface: #fffaf3;
		--color-text: #2b1a12;
		--color-muted: #2b1a12;
		--color-cta: #c24520;
		--color-cta-hover: #a3381a;
		--color-line: rgba(43, 26, 18, 0.12);
		--radius: 1.35rem;
		--radius-pill: 999px;
		--font-display: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
		--font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.5;
	}

	.barra {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-line);
	}

	.barra__inner {
		max-width: 1080px;
		margin: 0 auto;
		padding: 0.85rem 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.barra__marca {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.2rem;
		text-decoration: none;
		color: var(--color-text);
		letter-spacing: -0.03em;
	}

	.barra__marca span {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 0.75rem;
		margin-left: 0.35rem;
		opacity: 0.65;
	}

	.barra__acciones {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.barra__link,
	.barra__salir {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0.4rem 0.7rem;
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-text);
		background: none;
		border: none;
		cursor: pointer;
	}

	.contenido {
		max-width: 1080px;
		margin: 0 auto;
		padding: 1.25rem 1rem 6rem;
	}
</style>
