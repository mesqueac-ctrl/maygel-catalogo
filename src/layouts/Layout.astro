---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Maygel — Sandalias artesanales hechas a mano",
	description = "Maygel es un taller familiar de sandalias artesanales, hechas a mano con materiales de calidad. Conoce nuestro catálogo y consulta por WhatsApp.",
} = Astro.props;

const paginaUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const imagenUrl = new URL("/og-image.jpg", Astro.url.origin).href;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={paginaUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Maygel" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:url" content={paginaUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<!-- WhatsApp y Facebook exigen la URL completa, no una ruta relativa. -->
		<meta property="og:image" content={imagenUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imagenUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Inter:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
