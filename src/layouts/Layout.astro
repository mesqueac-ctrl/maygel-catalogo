---
import "../styles/global.css";
import { WHATSAPP_NUMBER, INSTAGRAM_URL } from "../consts";

interface Props {
	title?: string;
	description?: string;
	robots?: string;
	ogType?: string;
	ogImage?: string;
	ogImageAlt?: string;
}

const descripcionNegocio =
	"Maygel es un taller familiar de sandalias artesanales hechas bajo pedido en Soledad, Colombia, con entregas en Soledad y Barranquilla.";

const {
	title = "Maygel — Sandalias artesanales hechas a mano",
	description = descripcionNegocio,
	robots = "index, follow",
	ogType = "website",
	ogImage,
	ogImageAlt,
} = Astro.props;

const paginaUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const imagenUrl = ogImage ?? new URL("/og-image.jpg", Astro.url.origin).href;
const logoUrl = new URL("/icon-512.png", Astro.url.origin).href;
const imagenAlt = ogImageAlt ?? "Maygel — sandalias artesanales hechas a mano, con alma de familia";

// Datos estructurados del negocio: son los mismos en todas las páginas
// (no dependen del title/description de cada página) porque describen a
// Maygel como negocio, no el contenido de la página actual.
//
// Organization, no LocalBusiness (Fase 13.1 §9): LocalBusiness implica un
// establecimiento físico visitable — schema.org lo define como "a
// particular physical business" y Google espera `address`/`openingHours`
// para elegibilidad. Maygel no tiene local público: opera bajo pedido,
// coordinando todo por WhatsApp. Organization describe esto con precisión
// sin implicar ni requerir una dirección, y admite los mismos campos que ya
// usábamos (name, description, url, image, logo, telephone, areaServed,
// sameAs). No se inventa `address` ni `openingHours`.
const urlNegocio = new URL("/", Astro.url.origin).href;
const imagenNegocio = new URL("/og-image.jpg", Astro.url.origin).href;

const datosEstructurados = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Maygel",
	description: descripcionNegocio,
	url: urlNegocio,
	image: imagenNegocio,
	logo: logoUrl,
	telephone: `+${WHATSAPP_NUMBER}`,
	areaServed: ["Soledad", "Barranquilla"],
	sameAs: [INSTAGRAM_URL],
};
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content={robots} />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#8C5A2F" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={paginaUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Maygel" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:url" content={paginaUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<!-- WhatsApp y Facebook exigen la URL completa, no una ruta relativa. -->
		<meta property="og:image" content={imagenUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imagenAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imagenUrl} />
		<meta name="twitter:image:alt" content={imagenAlt} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Manrope:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<!--
			THESIS: Maygel no es un catálogo, es un taller — la web debe leerse
			como el atelier mismo, no como una tienda online. Rechaza el molde
			"DTC cálido": sin degradados con letra, sin botones-caja, sin eyebrows.
			OWN-WORLD: ivory/espresso/camel/champagne; Instrument Serif para
			frases de marca, Manrope para interfaz; botones como texto+flecha;
			fotografía reservada como bloque textil oscuro, nunca placeholder de
			mockup.
			STORY: la visitante entiende que cada par se hace a mano bajo pedido,
			y actúa por WhatsApp cuando quiere una.
			FIRST VIEWPORT: hero asimétrico 60/40 — bloque textil grande a la
			izquierda, titular serif corto y dos enlaces de texto a la derecha.
			FORM: dirección fijada por el usuario (quiet luxury / editorial
			boutique); ronda de concept-seed omitida por brief-pinned world
			(new-work.md §3-4, "brief-pinned direction beats the roll").
			FINISH: unreviewed and undocumented is unfinished; this build ends
			with the finish review, the verdict, and DESIGN.md.
		-->
		<a href="#contenido" class="skip-link">Saltar al contenido</a>
		<slot />
		<script>
			const elementos = document.querySelectorAll<HTMLElement>("[data-reveal]");
			if ("IntersectionObserver" in window && elementos.length > 0) {
				const observador = new IntersectionObserver(
					(entradas) => {
						entradas.forEach((entrada) => {
							if (entrada.isIntersecting) {
								entrada.target.classList.add("is-visible");
								observador.unobserve(entrada.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
				);
				elementos.forEach((el) => observador.observe(el));
			} else {
				elementos.forEach((el) => el.classList.add("is-visible"));
			}
		</script>
	</body>
</html>
