---
import "../styles/global.css";
import { WHATSAPP_NUMBER, INSTAGRAM_URL } from "../consts";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Maygel — Sandalias artesanales hechas a mano",
	description = "Maygel es un taller familiar de sandalias artesanales, hechas a mano con materiales de calidad. Conoce nuestro catálogo y consulta por WhatsApp.",
} = Astro.props;

const paginaUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const imagenUrl = new URL("/og-image.jpg", Astro.url.origin).href;

// Datos estructurados: ayuda a Google a mostrar Maygel como negocio local
// (nombre, contacto, zona de entrega) en los resultados de búsqueda.
const datosEstructurados = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	name: "Maygel",
	description,
	url: paginaUrl,
	image: imagenUrl,
	telephone: `+${WHATSAPP_NUMBER}`,
	priceRange: "$$",
	areaServed: ["Soledad", "Barranquilla", "Cartagena"],
	sameAs: [INSTAGRAM_URL],
};
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#FAF6F1" />

		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={paginaUrl} />
		<script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Maygel" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:url" content={paginaUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<!-- WhatsApp y Facebook exigen la URL completa, no una ruta relativa. -->
		<meta property="og:image" content={imagenUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imagenUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Inter:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
