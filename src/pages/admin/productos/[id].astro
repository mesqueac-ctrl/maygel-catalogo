---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductoForm from "../../../components/admin/ProductoForm.astro";
import { obtenerPorId } from "../../../lib/productos";

const id = Number(Astro.params.id);

if (!Number.isInteger(id)) {
	return Astro.redirect("/admin/productos");
}

const producto = await obtenerPorId(id);

if (!producto) {
	return Astro.redirect(
		"/admin/productos?error=" + encodeURIComponent("Esa sandalia ya no existe."),
	);
}
---

<AdminLayout titulo={`Editar ${producto.nombre}`}>
	<a class="volver" href="/admin/productos">← Volver a mis sandalias</a>

	<h1 class="titulo">Editar sandalia</h1>
	<p class="intro">Cambia lo que necesites y guarda los cambios.</p>

	<ProductoForm producto={producto} />
</AdminLayout>

<style>
	.volver {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 1rem;
		color: var(--color-accent-soft);
		text-decoration: none;
	}

	.volver:hover {
		color: var(--color-text);
	}

	.titulo {
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		margin-bottom: 0.5rem;
	}

	.intro {
		color: var(--color-accent-soft);
		font-weight: 300;
		margin-bottom: 2.5rem;
	}
</style>
