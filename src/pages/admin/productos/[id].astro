---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductoForm from "../../../components/admin/ProductoForm.astro";
import { obtenerPorId } from "../../../lib/productos";

const id = Number(Astro.params.id);

if (!Number.isInteger(id)) {
	return Astro.redirect("/admin/productos");
}

const producto = await obtenerPorId(id);

if (!producto) {
	return Astro.redirect(
		"/admin/productos?error=" + encodeURIComponent("Esa sandalia ya no existe."),
	);
}
---

<AdminLayout titulo={`Editar ${producto.nombre}`}>
	<a class="volver" href="/admin/productos">← Volver</a>
	<h1>Editar {producto.nombre}</h1>
	<p class="intro">Cambia lo que necesites y guarda.</p>
	<ProductoForm producto={producto} />
</AdminLayout>

<style>
	.volver {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
		color: var(--color-text);
		font-weight: 600;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: -0.04em;
		margin: 0.2rem 0 0.35rem;
	}
	.intro {
		margin: 0 0 1.25rem;
	}
</style>
