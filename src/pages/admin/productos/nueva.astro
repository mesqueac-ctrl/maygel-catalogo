---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductoForm from "../../../components/admin/ProductoForm.astro";
---

<AdminLayout titulo="Agregar sandalia">
	<a class="volver" href="/admin/productos">← Volver</a>
	<h1>Nueva sandalia</h1>
	<p class="intro">Nombre, precio, colores y una foto. Lo demás es opcional.</p>
	<ProductoForm />
</AdminLayout>

<style>
	.volver {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
		color: var(--color-text);
		font-weight: 600;
	}
	h1 {
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: -0.04em;
		margin: 0.2rem 0 0.35rem;
	}
	.intro {
		margin: 0 0 1.25rem;
	}
</style>
