---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ProductoForm from "../../../components/admin/ProductoForm.astro";
---

<AdminLayout titulo="Agregar sandalia nueva">
	<a class="volver" href="/admin/productos">← Volver a mis sandalias</a>

	<h1 class="titulo">Agregar sandalia nueva</h1>
	<p class="intro">Llena los datos y guarda. Aparecerá en tu página al instante.</p>

	<ProductoForm />
</AdminLayout>

<style>
	.volver {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 1rem;
		color: var(--color-accent-soft);
		text-decoration: none;
	}

	.volver:hover {
		color: var(--color-text);
	}

	.titulo {
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		margin-bottom: 0.5rem;
	}

	.intro {
		color: var(--color-accent-soft);
		font-weight: 300;
		margin-bottom: 2.5rem;
	}
</style>
