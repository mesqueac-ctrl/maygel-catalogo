---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { listarTodos, formatearPrecio } from "../../../lib/productos";

const productos = await listarTodos();

const mensajes: Record<string, string> = {
	movido: "Cambios guardados.",
};

const aviso = mensajes[Astro.url.searchParams.get("ok") ?? ""];
const error = Astro.url.searchParams.get("error");
const ordenInicial = JSON.stringify(productos.map((p) => p.id));
---

<AdminLayout titulo="Ordenar catálogo">
	<a class="volver" href="/admin/productos">← Volver a mis sandalias</a>

	<h1 class="titulo">Ordenar catálogo</h1>
	<p class="intro">
		Este es el orden en que tus sandalias aparecen en la página. Mueve las que
		quieras con "Aplicar" — no se guarda nada todavía. Cuando quedes conforme,
		pulsa <strong>Guardar orden</strong> al final para que se publique.
	</p>

	{aviso && <p class="aviso aviso--ok">✓ {aviso}</p>}
	{
		error && (
			<p class="aviso aviso--error">
				No se pudo completar la acción. {decodeURIComponent(error)}
			</p>
		)
	}

	<p class="estado" id="estado-guardado" role="status" aria-live="polite">Todo guardado.</p>
	<p class="mensaje-movimiento" id="mensaje-movimiento" role="alert" aria-live="assertive" hidden />

	{
		productos.length > 1 && (
			<label class="buscador">
				<span>Buscar por nombre o categoría</span>
				<input type="text" id="buscador-input" placeholder="Ej: Aura, Brillos..." autocomplete="off" />
				<span class="buscador__ayuda">
					Solo te ayuda a encontrarla — las posiciones siempre son del catálogo completo.
				</span>
			</label>
		)
	}

	{
		productos.length === 0 ? (
			<div class="vacio">
				<p>Todavía no tienes sandalias para ordenar.</p>
			</div>
		) : (
			<>
				<ul class="lista" id="lista-ordenar">
					{productos.map((producto, indice) => (
						<li
							class="fila"
							data-id={producto.id}
							data-nombre={producto.nombre.toLowerCase()}
							data-categoria={(producto.categoria ?? "").toLowerCase()}
						>
							<span class="fila__posicion" data-posicion>{indice + 1}</span>

							<img class="fila__foto" src={producto.imagen} alt={producto.nombre} />

							<div class="fila__datos">
								<p class="fila__nombre">{producto.nombre}</p>
								<p class="fila__meta">
									{formatearPrecio(producto.precio)}
									{producto.categoria && <> · {producto.categoria}</>}
								</p>
							</div>

							<div class="fila__mover">
								<label class="fila__mover-etiqueta">
									Mover a posición
									<input
										class="fila__mover-input"
										type="number"
										min="1"
										max={productos.length}
										value={indice + 1}
										data-input-posicion
									/>
								</label>
								<button class="fila__mover-boton" type="button" data-aplicar>Aplicar</button>
							</div>
						</li>
					))}
				</ul>

				<form class="form-guardar" method="POST" action="/admin/api/reordenar" id="form-guardar-orden">
					<input type="hidden" name="idsEnOrden" id="input-orden" value={ordenInicial} />
					<button class="boton-principal" type="submit">Guardar orden</button>
				</form>
			</>
		)
	}
</AdminLayout>

<script>
	const lista = document.getElementById("lista-ordenar");
	const estado = document.getElementById("estado-guardado");
	const mensajeMovimiento = document.getElementById("mensaje-movimiento");
	const inputOrden = document.getElementById("input-orden") as HTMLInputElement | null;
	const formGuardar = document.getElementById("form-guardar-orden") as HTMLFormElement | null;
	const buscador = document.getElementById("buscador-input") as HTMLInputElement | null;

	let sinGuardar = false;

	function totalFilas(): number {
		return lista ? lista.children.length : 0;
	}

	function idsEnOrdenActual(): number[] {
		if (!lista) return [];
		return [...lista.children].map((li) => Number((li as HTMLElement).dataset.id));
	}

	function renderPosiciones() {
		if (!lista) return;
		[...lista.children].forEach((li, indice) => {
			const elemento = li as HTMLElement;
			const badge = elemento.querySelector("[data-posicion]");
			if (badge) badge.textContent = String(indice + 1);
			const input = elemento.querySelector<HTMLInputElement>("[data-input-posicion]");
			if (input) input.value = String(indice + 1);
		});
	}

	function mostrarMensaje(texto: string) {
		if (!mensajeMovimiento) return;
		mensajeMovimiento.textContent = texto;
		mensajeMovimiento.hidden = false;
	}

	function limpiarMensaje() {
		if (!mensajeMovimiento) return;
		mensajeMovimiento.hidden = true;
		mensajeMovimiento.textContent = "";
	}

	function marcarSinGuardar() {
		sinGuardar = true;
		if (estado) estado.textContent = "Tienes cambios sin guardar.";
		if (inputOrden) inputOrden.value = JSON.stringify(idsEnOrdenActual());
	}

	lista?.querySelectorAll<HTMLElement>(".fila").forEach((fila) => {
		const boton = fila.querySelector<HTMLButtonElement>("[data-aplicar]");
		const input = fila.querySelector<HTMLInputElement>("[data-input-posicion]");

		boton?.addEventListener("click", () => {
			if (!lista || !input) return;

			const total = totalFilas();
			const valor = Number(input.value);

			if (!Number.isInteger(valor) || valor < 1 || valor > total) {
				mostrarMensaje(`Escribe un número entre 1 y ${total}.`);
				return;
			}

			limpiarMensaje();

			const filas = [...lista.children];
			const indiceActual = filas.indexOf(fila);
			const indiceDestino = valor - 1;

			if (indiceActual === indiceDestino) return;

			fila.remove();
			const referencia = lista.children[indiceDestino] ?? null;
			lista.insertBefore(fila, referencia);

			renderPosiciones();
			marcarSinGuardar();
		});
	});

	buscador?.addEventListener("input", () => {
		const termino = buscador.value.trim().toLowerCase();
		lista?.querySelectorAll<HTMLElement>(".fila").forEach((fila) => {
			const nombre = fila.dataset.nombre ?? "";
			const categoria = fila.dataset.categoria ?? "";
			const coincide = !termino || nombre.includes(termino) || categoria.includes(termino);
			fila.hidden = !coincide;
		});
	});

	formGuardar?.addEventListener("submit", () => {
		if (inputOrden) inputOrden.value = JSON.stringify(idsEnOrdenActual());
		sinGuardar = false;
	});

	window.addEventListener("beforeunload", (evento) => {
		if (!sinGuardar) return;
		evento.preventDefault();
	});
</script>

<style>
	.volver {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 1rem;
		color: var(--color-accent-soft);
		text-decoration: none;
	}

	.volver:hover {
		color: var(--color-text);
	}

	.titulo {
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		margin-bottom: 0.5rem;
	}

	.intro {
		color: var(--color-accent-soft);
		font-weight: 300;
		margin-bottom: 1.5rem;
		max-width: 60ch;
	}

	.intro strong {
		color: var(--color-text);
		font-weight: 500;
	}

	.aviso {
		padding: 1rem 1.25rem;
		margin-bottom: 1.5rem;
		font-size: 1rem;
		border: 1px solid;
	}

	.aviso--ok {
		background-color: #eef7ee;
		border-color: #b5d6b5;
		color: #2f6b33;
	}

	.aviso--error {
		background-color: #fdf1ee;
		border-color: #e6b8ab;
		color: #8c3a22;
	}

	.estado {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-accent-soft);
		margin-bottom: 1rem;
	}

	.mensaje-movimiento {
		font-size: 0.9375rem;
		font-weight: 500;
		color: #8c3a22;
		background-color: #fdf1ee;
		border: 1px solid #e6b8ab;
		padding: 0.75rem 1rem;
		margin-bottom: 1.5rem;
	}

	.buscador {
		display: block;
		margin-bottom: 2rem;
		max-width: 360px;
	}

	.buscador span {
		display: block;
		font-size: 0.9375rem;
		font-weight: 500;
		margin-bottom: 0.5rem;
	}

	.buscador__ayuda {
		font-weight: 300;
		color: var(--color-accent-soft);
		margin-top: 0.4rem;
	}

	.buscador input {
		width: 100%;
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--color-border);
	}

	.vacio {
		border: 1px dashed var(--color-border);
		padding: 3rem 2rem;
		text-align: center;
		color: var(--color-accent-soft);
		font-weight: 300;
	}

	.lista {
		list-style: none;
		margin: 0 0 2rem;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.fila {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--color-border);
		flex-wrap: wrap;
	}

	.fila__posicion {
		flex-shrink: 0;
		width: 32px;
		height: 32px;
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #f7efe7;
		font-weight: 500;
		font-size: 0.9375rem;
	}

	.fila__foto {
		width: 56px;
		height: 70px;
		object-fit: cover;
		background-color: #f2ece4;
		flex-shrink: 0;
	}

	.fila__datos {
		flex: 1 1 200px;
	}

	.fila__nombre {
		font-size: 1rem;
		font-weight: 500;
		margin-bottom: 0.25rem;
	}

	.fila__meta {
		font-size: 0.875rem;
		color: var(--color-accent-soft);
	}

	.fila__mover {
		display: flex;
		align-items: flex-end;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.fila__mover-etiqueta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.8125rem;
		color: var(--color-accent-soft);
	}

	.fila__mover-input {
		width: 72px;
		font-family: var(--font-body);
		font-size: 1rem;
		padding: 0.6rem 0.5rem;
		border: 1px solid var(--color-border);
		min-height: 44px;
		box-sizing: border-box;
	}

	.fila__mover-boton {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 500;
		padding: 0.7rem 1.1rem;
		min-height: 44px;
		box-sizing: border-box;
		background-color: #fff;
		color: var(--color-text);
		border: 1px solid var(--color-border);
		cursor: pointer;
	}

	.fila__mover-boton:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.form-guardar {
		display: flex;
		justify-content: flex-start;
	}

	.boton-principal {
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 500;
		padding: 1rem 1.75rem;
		background-color: var(--color-accent);
		color: #fff;
		border: none;
		cursor: pointer;
	}

	.boton-principal:hover {
		opacity: 0.88;
	}
</style>
