---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
	listarTodos,
	formatearPrecio,
	precioEfectivo,
	coloresComoLista,
	estaArchivado,
	COLORES_METADATA,
} from "../../../lib/productos";

const todos = await listarTodos();
const vista = Astro.url.searchParams.get("vista") ?? "activas";

const activas = todos.filter((p) => !estaArchivado(p.archivado));
const archivadas = todos.filter((p) => estaArchivado(p.archivado));
const productos = vista === "archivadas" ? archivadas : activas;

const mensajes: Record<string, string> = {
	guardado: "Guardado ✓",
	creado: "Sandalia nueva lista ✓",
	eliminado: "Se eliminó del todo.",
	archivado: "Archivada. Ya no se ve en la página.",
	restaurado: "Volvió a la lista ✓",
	orden: "Orden guardado ✓",
};

const aviso = mensajes[Astro.url.searchParams.get("ok") ?? ""];
const error = Astro.url.searchParams.get("error");
---

<AdminLayout titulo="Mis sandalias">
	{aviso && <p class="aviso aviso--ok">{aviso}</p>}
	{error && <p class="aviso aviso--error">{decodeURIComponent(error)}</p>}

	<header class="cabecera">
		<div>
			<h1>Mis sandalias</h1>
			<p class="sub">{activas.length} en el catálogo · {archivadas.length} archivadas</p>
		</div>
		<a class="btn-admin" href="/admin/productos/nueva">Agregar sandalia</a>
	</header>

	<label class="buscador">
		<span class="sr-only">Buscar</span>
		<input type="search" id="buscador" placeholder="Buscar por nombre" autocomplete="off" />
	</label>

	<nav class="tabs" aria-label="Filtros">
		<a class:list={["tab", vista !== "archivadas" && "is-on"]} href="/admin/productos">En el catálogo</a>
		<a class:list={["tab", vista === "archivadas" && "is-on"]} href="/admin/productos?vista=archivadas">
			Archivadas ({archivadas.length})
		</a>
	</nav>

	{
		productos.length === 0 ? (
			<p class="vacio">
				{vista === "archivadas" ? "No hay sandalias archivadas." : "Todavía no hay sandalias. Agrega la primera."}
			</p>
		) : (
			<ul class="grid" id="lista" data-vista={vista}>
				{productos.map((producto) => {
					const colores = coloresComoLista(producto.colores);
					const precio = formatearPrecio(precioEfectivo(producto));
					return (
						<li
							class="card"
							draggable={vista !== "archivadas"}
							data-id={producto.id}
							data-nombre={producto.nombre.toLowerCase()}
							data-disponible={producto.disponible ? "si" : "no"}
						>
							{vista !== "archivadas" && (
								<div class="card__mover">
									<button type="button" class="icon-btn" data-dir="-1" aria-label={`Subir ${producto.nombre}`}>
										↑
									</button>
									<span class="asa" aria-hidden="true">⋮⋮</span>
									<button type="button" class="icon-btn" data-dir="1" aria-label={`Bajar ${producto.nombre}`}>
										↓
									</button>
								</div>
							)}
							<a class="card__media" href={`/admin/productos/${producto.id}`}>
								<img src={producto.imagen} alt="" />
							</a>
							<div class="card__body">
								<h2>{producto.nombre}</h2>
								<p class="precio">{precio}</p>
								<p class:list={["estado", !producto.disponible && "estado--off"]}>
									{producto.disponible ? "Se ve en la página" : "Oculta"}
								</p>
								<div class="dots">
									{colores.map((color) => {
										const meta = COLORES_METADATA[color];
										return (
											<span
												style={`background:${meta.hex};border-color:${meta.border}`}
												title={meta.nombre}
											/>
										);
									})}
								</div>
								<div class="card__acciones">
									{vista !== "archivadas" ? (
										<>
											<button type="button" class="btn-ghost" data-ocultar={producto.id} data-ahora={producto.disponible ? "si" : "no"}>
												{producto.disponible ? "Ocultar" : "Mostrar"}
											</button>
											<a class="btn-ghost" href={`/admin/productos/${producto.id}`}>Editar</a>
											<button type="button" class="btn-ghost btn-ghost--warn" data-archivar={producto.id}>
												Archivar
											</button>
										</>
									) : (
										<>
											<button type="button" class="btn-ghost" data-restaurar={producto.id}>
												Restaurar
											</button>
											<form method="POST" action="/admin/api/eliminar" data-borrar={producto.nombre}>
												<input type="hidden" name="id" value={producto.id} />
												<input type="hidden" name="vista" value="archivadas" />
												<button class="btn-ghost btn-ghost--warn" type="submit">
													Eliminar definitivamente
												</button>
											</form>
										</>
									)}
								</div>
							</div>
						</li>
					);
				})}
			</ul>
		)
	}

	<div class="toast" id="toast" hidden>
		<p id="toast-msg"></p>
		<button type="button" id="toast-undo">Deshacer</button>
	</div>
</AdminLayout>

<script>
	const lista = document.getElementById("lista");
	const toast = document.getElementById("toast");
	const toastMsg = document.getElementById("toast-msg");
	const toastUndo = document.getElementById("toast-undo");
	let undoTimer = 0;
	let undoFn: (() => void) | null = null;

	function idsActuales(): number[] {
		return [...(lista?.querySelectorAll<HTMLElement>(".card") ?? [])].map((el) => Number(el.dataset.id));
	}

	async function postForm(url: string, campos: Record<string, string>) {
		const datos = new FormData();
		datos.set("ajax", "1");
		for (const [k, v] of Object.entries(campos)) datos.set(k, v);
		const res = await fetch(url, { method: "POST", body: datos });
		return res.json() as Promise<{ ok: boolean; mensaje: string }>;
	}

	function mostrarToast(texto: string, deshacer: () => void) {
		if (!toast || !toastMsg || !toastUndo) return;
		toastMsg.textContent = texto;
		toast.hidden = false;
		undoFn = deshacer;
		window.clearTimeout(undoTimer);
		undoTimer = window.setTimeout(() => {
			toast.hidden = true;
			undoFn = null;
		}, 5000);
	}

	toastUndo?.addEventListener("click", () => {
		undoFn?.();
		if (toast) toast.hidden = true;
		undoFn = null;
		window.clearTimeout(undoTimer);
	});

	async function guardarOrden() {
		if (!lista || lista.dataset.vista === "archivadas") return;
		await postForm("/admin/api/reordenar", { idsEnOrden: JSON.stringify(idsActuales()) });
	}

	function mover(card: HTMLElement, dir: number) {
		if (!lista) return;
		const vecino = dir < 0 ? card.previousElementSibling : card.nextElementSibling;
		if (!vecino) return;
		if (dir < 0) lista.insertBefore(card, vecino);
		else lista.insertBefore(vecino, card);
		void guardarOrden();
	}

	document.getElementById("buscador")?.addEventListener("input", (evento) => {
		const q = (evento.target as HTMLInputElement).value.trim().toLowerCase();
		lista?.querySelectorAll<HTMLElement>(".card").forEach((card) => {
			card.hidden = Boolean(q) && !(card.dataset.nombre ?? "").includes(q);
		});
	});

	lista?.addEventListener("click", async (evento) => {
		const t = evento.target as HTMLElement;
		const subir = t.closest<HTMLButtonElement>("[data-dir]");
		if (subir) {
			const card = subir.closest<HTMLElement>(".card");
			if (card) mover(card, Number(subir.dataset.dir));
			return;
		}

		const ocultar = t.closest<HTMLButtonElement>("[data-ocultar]");
		if (ocultar) {
			const id = ocultar.dataset.ocultar ?? "";
			const ahora = ocultar.dataset.ahora === "si";
			const siguiente = ahora ? "no" : "si";
			const card = ocultar.closest<HTMLElement>(".card");
			await postForm("/admin/api/estado", { id, disponible: siguiente });
			ocultar.dataset.ahora = siguiente;
			ocultar.textContent = siguiente === "si" ? "Ocultar" : "Mostrar";
			const estado = card?.querySelector(".estado");
			if (estado) {
				estado.textContent = siguiente === "si" ? "Se ve en la página" : "Oculta";
				estado.classList.toggle("estado--off", siguiente !== "si");
			}
			mostrarToast(siguiente === "si" ? "Visible otra vez." : "Oculta. Nadie la ve en la página.", async () => {
				await postForm("/admin/api/estado", { id, disponible: ahora ? "si" : "no" });
				location.reload();
			});
			return;
		}

		const archivar = t.closest<HTMLButtonElement>("[data-archivar]");
		if (archivar) {
			const id = archivar.dataset.archivar ?? "";
			const card = archivar.closest<HTMLElement>(".card");
			if (!confirm("¿Archivar esta sandalia? Sale de la página. La puedes recuperar en Archivadas.")) return;
			await postForm("/admin/api/archivar", { id, archivado: "si" });
			card?.remove();
			mostrarToast("Archivada.", async () => {
				await postForm("/admin/api/archivar", { id, archivado: "no" });
				location.reload();
			});
			return;
		}

		const restaurar = t.closest<HTMLButtonElement>("[data-restaurar]");
		if (restaurar) {
			const id = restaurar.dataset.restaurar ?? "";
			await postForm("/admin/api/archivar", { id, archivado: "no" });
			restaurar.closest<HTMLElement>(".card")?.remove();
		}
	});

	lista?.querySelectorAll<HTMLFormElement>("form[data-borrar]").forEach((form) => {
		form.addEventListener("submit", (evento) => {
			const nombre = form.dataset.borrar ?? "esta sandalia";
			if (!confirm(`¿Eliminar "${nombre}" para siempre? También se borran sus fotos. Esto no se puede deshacer.`)) {
				evento.preventDefault();
			}
		});
	});

	let dragged: HTMLElement | null = null;
	lista?.addEventListener("dragstart", (evento) => {
		const card = (evento.target as HTMLElement).closest<HTMLElement>(".card");
		if (!card || lista.dataset.vista === "archivadas") return;
		dragged = card;
		card.classList.add("is-drag");
	});
	lista?.addEventListener("dragend", () => {
		dragged?.classList.remove("is-drag");
		dragged = null;
		void guardarOrden();
	});
	lista?.addEventListener("dragover", (evento) => {
		evento.preventDefault();
		const over = (evento.target as HTMLElement).closest<HTMLElement>(".card");
		if (!dragged || !over || over === dragged || !lista) return;
		const rect = over.getBoundingClientRect();
		const before = evento.clientY < rect.top + rect.height / 2;
		lista.insertBefore(dragged, before ? over : over.nextSibling);
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: -0.04em;
		font-size: clamp(1.7rem, 5vw, 2.4rem);
		margin: 0 0 0.25rem;
	}

	.sub {
		margin: 0;
		opacity: 0.8;
	}

	.cabecera {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 1.1rem;
	}

	.aviso {
		padding: 0.85rem 1rem;
		border-radius: 0.85rem;
		margin-bottom: 1rem;
	}

	.aviso--ok {
		background: #e7f3ea;
		color: #215c32;
	}

	.aviso--error {
		background: #fdece6;
		color: #8c3a22;
	}

	.buscador input {
		width: 100%;
		min-height: 44px;
		border-radius: 0.85rem;
		border: 1.5px solid var(--color-text);
		padding: 0.55rem 0.9rem;
		font: inherit;
		margin-bottom: 0.85rem;
		background: var(--color-surface);
	}

	.tabs {
		display: flex;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}

	.tab {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.9rem;
		border-radius: var(--radius-pill);
		text-decoration: none;
		color: var(--color-text);
		border: 1.5px solid transparent;
		font-weight: 600;
		font-size: 0.9rem;
	}

	.tab.is-on {
		border-color: var(--color-text);
		background: var(--color-surface);
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.85rem;
	}

	@media (min-width: 700px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 1100px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.card {
		background: var(--color-surface);
		border-radius: var(--radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		box-shadow: 0 8px 22px rgba(43, 26, 18, 0.07);
	}

	.card.is-drag {
		opacity: 0.55;
	}

	.card__mover {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		padding: 0.35rem;
	}

	.asa {
		cursor: grab;
		letter-spacing: -0.15em;
		opacity: 0.45;
	}

	.icon-btn {
		min-width: 44px;
		min-height: 44px;
		border: none;
		background: none;
		font: inherit;
		cursor: pointer;
	}

	.card__media {
		display: block;
		aspect-ratio: 4 / 5;
		background: #ead9c6;
	}

	.card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card__body {
		padding: 0.8rem 0.9rem 1rem;
		display: grid;
		gap: 0.25rem;
	}

	.card__body h2 {
		font-size: 1.05rem;
		margin: 0;
	}

	.precio {
		font-weight: 600;
		margin: 0;
	}

	.estado {
		font-size: 0.8125rem;
		color: #215c32;
		margin: 0;
	}

	.estado--off {
		color: #8c3a22;
	}

	.dots {
		display: flex;
		flex-wrap: wrap;
		gap: 0.28rem;
		min-height: 20px;
	}

	.dots span {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		border: 1.5px solid;
	}

	.card__acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.45rem;
	}

	.btn-admin,
	.btn-ghost {
		min-height: 44px;
		padding: 0.45rem 0.9rem;
		border-radius: var(--radius-pill);
		font: inherit;
		font-weight: 600;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		cursor: pointer;
	}

	.btn-admin {
		background: var(--color-cta);
		color: #fff;
		border: none;
	}

	.btn-ghost {
		background: transparent;
		color: var(--color-text);
		border: 1.5px solid var(--color-text);
	}

	.btn-ghost--warn {
		border-color: #8c3a22;
		color: #8c3a22;
	}

	.vacio {
		padding: 2rem 0;
	}

	.toast {
		position: fixed;
		left: 1rem;
		right: 1rem;
		bottom: 1rem;
		z-index: 30;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		background: #2b1a12;
		color: #fffaf3;
		padding: 0.85rem 1rem;
		border-radius: 0.9rem;
		min-height: 52px;
	}

	.toast button {
		min-height: 44px;
		background: none;
		border: none;
		color: #e8b04a;
		font: inherit;
		font-weight: 700;
		cursor: pointer;
	}

	.toast[hidden] {
		display: none;
	}
</style>
