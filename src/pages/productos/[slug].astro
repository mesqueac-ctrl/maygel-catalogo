---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import ContactFooter from "../../components/ContactFooter.astro";
import ProductCard from "../../components/ProductCard.astro";
import { Image } from "astro:assets";
import {
	obtenerPorSlug,
	listarDisponibles,
	formatearPrecio,
	precioEfectivo,
	tieneDescuento,
	descripcionImagen,
	descripcionPublica,
	estaArchivado,
	coloresComoLista,
	tallasComoLista,
	esTallaFlexible,
	imagenParaColor,
	imagenesColoresComoMapa,
	COLORES_METADATA,
} from "../../lib/productos";
import { enlaceProducto } from "../../lib/whatsapp";
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL, MENSAJE_DUDA_COMPRA, MENSAJE_AYUDA, SEO_PRODUCTO } from "../../consts";

const { slug } = Astro.params;
const producto = slug ? await obtenerPorSlug(slug) : undefined;

// Slug inexistente: 404 real, nunca una página 200 vacía.
if (!producto || estaArchivado(producto.archivado)) {
	return Astro.rewrite("/404");
}

const textoDescripcion = descripcionPublica(producto.nombre, producto.descripcion);

// "No disponible" es distinto de "no encontrado": la página se conserva
// (puede tener enlaces externos o historial de indexación), pero se marca
// noindex y no se ofrece ningún flujo de compra sobre un producto oculto.
const disponible = producto.disponible;

const colores = coloresComoLista(producto.colores);
const tallas = tallasComoLista(producto.tallas);
const unicoColor = colores.length === 1 ? colores[0] : null;
// Talla flexible (Fase 8.4): la fabricación es según pedido, no hay rango
// fijo que publicar — ver ARCHITECTURE.md § tallas / PRODUCT_PAGE_SPEC.md.
const tallaFlexible = esTallaFlexible(producto.tallas);
const unicaTalla = !tallaFlexible && tallas.length === 1 ? tallas[0] : null;
const tallaFlexibleTexto = tallas[0] || "Según pedido";
const mapaImagenesColores = imagenesColoresComoMapa(producto.imagenesColores);

// Galería: el modelo de datos actual solo soporta una foto principal +,
// opcionalmente, una foto distinta por color — no una galería de varias
// imágenes por producto. Este bloque ya soporta ese caso (cambia de foto al
// elegir color cuando existe una específica); una galería real de N fotos es
// una capacidad futura, documentada en HOMEPAGE_SPEC.md § Photography
// Production Needs, no inventada aquí.
const imagenInicial = imagenParaColor(producto, unicoColor);
const esRemota = imagenInicial.startsWith("http");
// Fase 13.1: metadata SEO específica por producto (aprobada), con fallback
// al texto genérico anterior para cualquier slug que todavía no esté en
// SEO_PRODUCTO (defensivo — nunca debe quedar una página sin alt/meta).
const seoProducto = SEO_PRODUCTO[producto.slug];
const altImagen = seoProducto?.alt ?? descripcionImagen(producto.nombre);

const paginaUrl = new URL(`/productos/${producto.slug}`, Astro.url.origin).href;
const inicioUrl = new URL("/", Astro.url.origin).href;
const imagenUrl = new URL(imagenInicial, Astro.url.origin).href;
const title = `${producto.nombre} — Sandalia plana artesanal | Maygel`;
const description =
	seoProducto?.metaDescription ??
	`${textoDescripcion} Sandalia artesanal hecha a mano, fabricación bajo pedido. ${formatearPrecio(precioEfectivo(producto))}.`;
const ogImageAlt = altImagen;
// "No disponible" hoy no significa "página sin valor": sigue teniendo
// enlaces internos reales (migas, relacionados, footer) que conviene que se
// sigan rastreando — solo se retira de los resultados de búsqueda como
// producto (noindex), no se corta el rastreo hacia el resto del sitio
// (nofollow). Ver docs/SEO_RULES.md § disponibilidad.
const robots = disponible ? "index, follow" : "noindex, follow";

const necesitaColor = disponible && colores.length > 1;
// En modo flexible la talla nunca bloquea el CTA — es información opcional
// que la clienta escribe libremente, no una selección obligatoria de una
// lista inventada (Fase 8.4).
const necesitaTalla = disponible && !tallaFlexible && tallas.length > 1;

const hayDescuento = tieneDescuento(producto);
const precioFormateado = formatearPrecio(precioEfectivo(producto));
const precioAnteriorFormateado = hayDescuento ? formatearPrecio(producto.precio) : null;

const enlaceWhatsappInicial =
	disponible && !necesitaColor && !necesitaTalla
		? enlaceProducto(producto.nombre, unicoColor, paginaUrl, unicaTalla, precioFormateado)
		: "#";

// No se afirma rating, review, SKU, GTIN ni stock — no existen en los datos.
//
// `availability` se omite a propósito (Fase 5.1): Schema.org sí define
// `MadeToOrder` dentro de ItemAvailability, pero la documentación de Google
// para Product structured data (developers.google.com/search/docs/appearance/
// structured-data/product-snippet, verificado en esta fase) no lo incluye en
// su lista de valores reconocidos para `availability` — solo BackOrder,
// Discontinued, InStock, InStoreOnly, LimitedAvailability, OnlineOnly,
// OutOfStock, PreOrder, PreSale y SoldOut. Ninguno describe con honestidad
// "se fabrica después de pedirlo, sin inventario previo": `InStock` sería
// falso, `PreOrder`/`BackOrder` implican un concepto de inventario que no
// existe en este negocio. Google documenta `availability` como propiedad
// "recomendada", no requerida — se omite en vez de forzar un valor
// incorrecto. El hecho de que sea "bajo pedido" sigue comunicado como texto
// real y visible en la página ("Hecho a mano, bajo pedido..."), no como dato
// estructurado falso.
const datosEstructurados = disponible
	? {
			"@context": "https://schema.org",
			"@type": "Product",
			name: producto.nombre,
			// La capa SEO usa la descripción larga aprobada (SEO_PRODUCTO), no el
			// slogan editorial corto de `producto.descripcion` (ese sigue siendo
			// el texto visible en la ficha, sin tocar) — Fase 13.3 §3: el slogan
			// es demasiado genérico para describir el producto en datos
			// estructurados.
			description: seoProducto?.metaDescription ?? textoDescripcion,
			image: imagenUrl,
			url: paginaUrl,
			brand: { "@type": "Brand", name: "Maygel" },
			offers: {
				"@type": "Offer",
				// Precio efectivo (con descuento aplicado si existe, Fase 8.2) — el
				// que realmente se ofrece, nunca el precio normal si hay una oferta
				// activa. `priceValidUntil` no se incluye: no existe una fecha real
				// de fin de oferta que afirmar.
				price: precioEfectivo(producto),
				priceCurrency: "COP",
				url: paginaUrl,
			},
		}
	: null;

// BreadcrumbList (Fase 13.3 §5): "Colección" no es una página real, es un
// ancla dentro de home (/#catalogo). Google espera una URL de página para
// cada nivel del breadcrumb estructurado, y un fragmento no lo es — no se
// crea una página /coleccion solo para justificar el dato estructurado
// (instrucción explícita del negocio). Se refleja la jerarquía real del
// sitio: Inicio → Producto. El breadcrumb visible en pantalla (nav.migas)
// no cambia — sigue mostrando "Colección" como paso de UX, independiente
// del dato estructurado.
const breadcrumbLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: "Inicio", item: inicioUrl },
		{ "@type": "ListItem", position: 2, name: producto.nombre, item: paginaUrl },
	],
};

// Relacionados: solo si hay valor real que mostrar (otros productos
// disponibles) — máximo 3, excluyendo el actual. Nada de recomendación
// "inteligente": mismo orden de catálogo.
const relacionados = disponible
	? (await listarDisponibles()).filter((p) => p.id !== producto.id).slice(0, 3)
	: [];

const whatsappGeneral = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
const whatsappDudaTalla = buildWhatsappLink(MENSAJE_DUDA_COMPRA);
const whatsappAyuda = buildWhatsappLink(MENSAJE_AYUDA);
---

<Layout
	title={title}
	description={description}
	ogType="product"
	ogImage={imagenUrl}
	ogImageAlt={ogImageAlt}
	robots={robots}
>
	<Header />
	<main id="contenido">
		<section class="ficha section">
			<div class="container">
				<nav class="migas" aria-label="Ruta de navegación">
					<ol>
						<li><a href="/">Inicio</a></li>
						<li><a href="/#catalogo">Colección</a></li>
						<li aria-current="page">{producto.nombre}</li>
					</ol>
				</nav>

				<div class="ficha__layout">
					<div class="ficha__galeria">
						{
							esRemota ? (
								<Image
									src={imagenInicial}
									alt={altImagen}
									width={1000}
									height={1250}
									widths={[500, 1000, 1500]}
									sizes="(min-width: 700px) 50vw, 100vw"
									format="webp"
									loading="eager"
									fetchpriority="high"
									data-ficha-imagen
								/>
							) : (
								<img
									src={imagenInicial}
									alt={altImagen}
									width="1000"
									height="1250"
									loading="eager"
									fetchpriority="high"
									decoding="async"
									data-ficha-imagen
								/>
							)
						}
					</div>

					<div class="ficha__info">
						<h1 class="ficha__nombre">Sandalia {producto.nombre}</h1>
						<p class="ficha__precio">
							{precioAnteriorFormateado && (
								<span class="ficha__precio-anterior">{precioAnteriorFormateado}</span>
							)}
							<span class="ficha__precio-actual">{precioFormateado}</span>
						</p>

						{
							!disponible && (
								<div class="ficha__no-disponible" role="status">
									<p>
										Este modelo ya no está disponible. Escríbenos por WhatsApp si buscas algo
										similar o quieres consultar otras opciones.
									</p>
									<a class="btn" href={whatsappGeneral} target="_blank" rel="noopener noreferrer">
										Escríbenos por WhatsApp
									</a>
									<a class="ficha__volver" href="/#catalogo">← Volver al catálogo</a>
								</div>
							)
						}

						{
							disponible && (
								<>
									<p class="ficha__descripcion">{textoDescripcion}</p>

									{colores.length > 0 && (
										<fieldset class="ficha__grupo" data-grupo-color>
											<legend class="ficha__etiqueta">
												Color{necesitaColor && <span class="ficha__requerido"> (elige uno)</span>}
											</legend>
											<div class="ficha__opciones" role="group" aria-label="Elegir color">
												{colores.map((color) => {
													const meta = COLORES_METADATA[color];
													const esActivo = unicoColor === color;
													return (
														<button
															type="button"
															class={`ficha__color ${esActivo ? "ficha__color--activo" : ""}`}
															data-color={color}
															data-imagen-color={mapaImagenesColores[color] ?? ""}
															aria-pressed={esActivo ? "true" : "false"}
														>
															<span
																class="ficha__color-muestra"
																style={`background-color: ${meta.hex}; border-color: ${meta.border};`}
																aria-hidden="true"
															/>
															<span class="ficha__color-nombre">{color}</span>
														</button>
													);
												})}
											</div>
										</fieldset>
									)}

									{tallaFlexible ? (
										<div class="ficha__grupo" data-grupo-talla-flexible>
											<span class="ficha__etiqueta">Talla</span>
											<p class="ficha__talla-flexible-texto">{tallaFlexibleTexto}</p>
											<label class="ficha__talla-libre-label">
												<span class="campo__ayuda">¿Cuál es tu talla? (opcional)</span>
												<input
													class="ficha__talla-libre"
													type="text"
													inputmode="numeric"
													placeholder="Ej: 37"
													data-talla-libre
													maxlength="10"
												/>
											</label>
											<details class="ficha__guia">
												<summary>¿No sabes tu talla?</summary>
												<p>Escríbenos por WhatsApp y te ayudamos a elegir la talla correcta.</p>
												<a href={whatsappDudaTalla} target="_blank" rel="noopener noreferrer">
													Preguntar por WhatsApp
												</a>
											</details>
										</div>
									) : (
										tallas.length > 0 && (
											<fieldset class="ficha__grupo" data-grupo-talla>
												<legend class="ficha__etiqueta">
													Talla{necesitaTalla && <span class="ficha__requerido"> (elige una)</span>}
												</legend>
												<div class="ficha__opciones" role="group" aria-label="Elegir talla">
													{tallas.map((talla) => (
														<button
															type="button"
															class={`ficha__talla ${unicaTalla === talla ? "ficha__talla--activo" : ""}`}
															data-talla={talla}
															aria-pressed={unicaTalla === talla ? "true" : "false"}
														>
															{talla}
														</button>
													))}
												</div>
												<details class="ficha__guia">
													<summary>Guía de tallas</summary>
													<p>
														Todavía no tenemos una guía de tallas publicada. Escríbenos por WhatsApp
														y te ayudamos a elegir la talla correcta.
													</p>
													<a href={whatsappDudaTalla} target="_blank" rel="noopener noreferrer">
														Preguntar por WhatsApp
													</a>
												</details>
											</fieldset>
										)
									)}

									<p class="ficha__mensaje" id="ficha-mensaje" role="alert" aria-live="assertive" hidden />

									<a
										class="btn ficha__cta"
										id="ficha-cta"
										data-ficha-cta
										href={enlaceWhatsappInicial}
										target={enlaceWhatsappInicial === "#" ? undefined : "_blank"}
										rel={enlaceWhatsappInicial === "#" ? undefined : "noopener noreferrer"}
										data-nombre={producto.nombre}
										data-url={paginaUrl}
										data-precio={precioFormateado}
									>
										Pedir este par
									</a>

									<p class="ficha__tag">Hecho a mano, bajo pedido — se fabrica después de tu pedido. Suela de goma.</p>
									<p class="ficha__tiempo">Te confirmamos el tiempo de entrega por WhatsApp.</p>
									<p class="ficha__tallas-link">
										<a href="/ayuda#tallas">Consulta tu talla</a>
									</p>

									<p class="ficha__ayuda">
										¿Necesitas ayuda con talla, color o pedido?{" "}
										<a href={whatsappAyuda} target="_blank" rel="noopener noreferrer">Te guiamos por WhatsApp</a>.
									</p>

									<details class="ficha__disclosure">
										<summary>Envíos y cambios</summary>
										<p>
											Entregamos en Soledad (con pago contraentrega) y Barranquilla (domicilio a
											cargo de la clienta, entre $10.000 y $15.000 COP). En Cartagena solo
											atendemos pedidos al por mayor. Aceptamos cambios por talla, detalles o
											defectos — el envío del cambio se cobra de nuevo.{" "}
											<a href="/ayuda">Ver la guía completa</a>.
										</p>
									</details>
								</>
							)
						}
					</div>
				</div>

				{
					relacionados.length > 0 && (
						<div class="relacionados">
							<h2 class="relacionados__titulo">También puede gustarte</h2>
							<div class="relacionados__grid">
								{relacionados.map((rel) => (
									<ProductCard producto={rel} />
								))}
							</div>
						</div>
					)
				}
			</div>
		</section>
		{
			disponible && (
				<div class="ficha-cta-fijo">
					<a
						class="btn"
						data-ficha-cta
						href={enlaceWhatsappInicial}
						target={enlaceWhatsappInicial === "#" ? undefined : "_blank"}
						rel={enlaceWhatsappInicial === "#" ? undefined : "noopener noreferrer"}
					>
						Pedir este par
					</a>
				</div>
			)
		}
	</main>
	<ContactFooter />
	{datosEstructurados && <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />}
	<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
</Layout>

<script>
	import { mensajeProducto, buildWhatsappLink } from "../../lib/whatsapp";

	const ctas = document.querySelectorAll<HTMLAnchorElement>("[data-ficha-cta]");
	const cta = document.getElementById("ficha-cta") as HTMLAnchorElement | null;
	const mensajeError = document.getElementById("ficha-mensaje");
	const imagen = document.querySelector<HTMLImageElement>("[data-ficha-imagen]");
	const gruposColor = document.querySelectorAll<HTMLButtonElement>("[data-grupo-color] [data-color]");
	const gruposTalla = document.querySelectorAll<HTMLButtonElement>("[data-grupo-talla] [data-talla]");
	// Talla flexible (Fase 8.4): campo de texto libre, opcional, nunca
	// bloquea el CTA — se envía tal cual lo escribió la clienta, nunca un
	// valor inventado como "cualquier talla".
	const inputTallaLibre = document.querySelector<HTMLInputElement>("[data-talla-libre]");

	if (cta) {
		const nombre = cta.dataset.nombre ?? "";
		const url = cta.dataset.url;
		const precio = cta.dataset.precio ?? null;
		let colorElegido: string | null = gruposColor.length === 1 ? gruposColor[0].dataset.color ?? null : null;
		let tallaElegida: string | null = gruposTalla.length === 1 ? gruposTalla[0].dataset.talla ?? null : null;

		gruposColor.forEach((boton) => {
			if (boton.classList.contains("ficha__color--activo")) colorElegido = boton.dataset.color ?? null;
		});
		gruposTalla.forEach((boton) => {
			if (boton.classList.contains("ficha__talla--activo")) tallaElegida = boton.dataset.talla ?? null;
		});

		function limpiarError() {
			if (!mensajeError) return;
			mensajeError.hidden = true;
			mensajeError.textContent = "";
		}

		function actualizarEnlace() {
			const faltaColor = gruposColor.length > 1 && !colorElegido;
			const faltaTalla = gruposTalla.length > 1 && !tallaElegida;

			ctas.forEach((boton) => {
				if (faltaColor || faltaTalla) {
					boton.href = "#";
					boton.removeAttribute("target");
					return;
				}
				const mensaje = mensajeProducto(nombre, colorElegido, url, tallaElegida, precio);
				boton.href = buildWhatsappLink(mensaje);
				boton.target = "_blank";
				boton.rel = "noopener noreferrer";
			});
		}

		gruposColor.forEach((boton) => {
			boton.addEventListener("click", () => {
				gruposColor.forEach((b) => {
					b.classList.remove("ficha__color--activo");
					b.setAttribute("aria-pressed", "false");
				});
				boton.classList.add("ficha__color--activo");
				boton.setAttribute("aria-pressed", "true");
				colorElegido = boton.dataset.color ?? null;

				// Solo cambia la foto si existe una relación real color→imagen
				// para ese color (nunca se inventa una imagen distinta).
				const imagenColor = boton.dataset.imagenColor;
				if (imagen && imagenColor) {
					imagen.src = imagenColor;
					imagen.alt = `${nombre} — color ${colorElegido}`;
				}

				limpiarError();
				actualizarEnlace();
			});
		});

		gruposTalla.forEach((boton) => {
			boton.addEventListener("click", () => {
				gruposTalla.forEach((b) => {
					b.classList.remove("ficha__talla--activo");
					b.setAttribute("aria-pressed", "false");
				});
				boton.classList.add("ficha__talla--activo");
				boton.setAttribute("aria-pressed", "true");
				tallaElegida = boton.dataset.talla ?? null;
				limpiarError();
				actualizarEnlace();
			});
		});

		inputTallaLibre?.addEventListener("input", () => {
			tallaElegida = inputTallaLibre.value.trim() || null;
			actualizarEnlace();
		});

		ctas.forEach((boton) => {
			boton.addEventListener("click", (evento) => {
				const faltaColor = gruposColor.length > 1 && !colorElegido;
				const faltaTalla = gruposTalla.length > 1 && !tallaElegida;

				if (faltaColor || faltaTalla) {
					evento.preventDefault();
					if (mensajeError) {
						mensajeError.hidden = false;
						mensajeError.textContent = faltaColor
							? "Selecciona un color para continuar."
							: "Selecciona una talla para continuar.";
					}
					const grupo = faltaColor
						? document.querySelector<HTMLElement>("[data-grupo-color] button")
						: document.querySelector<HTMLElement>("[data-grupo-talla] button");
					grupo?.focus();
				}
			});
		});

		actualizarEnlace();
	}
</script>

<style>
	.ficha {
		padding-top: clamp(1.5rem, 4vw, 2.5rem);
	}

	.migas {
		margin-bottom: clamp(2rem, 5vw, 3rem);
	}

	.migas ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 0.8125rem;
		color: var(--color-muted);
	}

	.migas li:not(:last-child)::after {
		content: "/";
		margin-left: 0.4rem;
		color: var(--color-line);
	}

	.migas a {
		text-decoration: none;
		color: var(--color-muted);
	}

	.migas a:hover {
		color: var(--color-accent);
	}

	.migas li[aria-current="page"] {
		color: var(--color-text);
	}

	.ficha__layout {
		display: grid;
		gap: clamp(2rem, 5vw, 3rem);
	}

	.ficha__galeria {
		width: 100%;
		aspect-ratio: 4 / 5;
		/* Fase 11.1: en mobile, sin tope, la imagen ocupa casi toda la primera
		   pantalla y empuja precio/CTA fuera del viewport inicial. Se limita
		   por ancho (nunca por vh) para que el nombre/precio empiecen a
		   asomar de inmediato, sin depender de la altura del dispositivo. */
		max-height: clamp(320px, 90vw, 420px);
		overflow: hidden;
		border-radius: var(--radius);
