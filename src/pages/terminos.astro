---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ContactFooter from "../components/ContactFooter.astro";
import { buildWhatsappLink, MENSAJE_CONTACTO_GENERAL } from "../consts";

// Página de términos básica (Fase 8.3) — solo afirma lo que ya está
// confirmado en COMMERCIAL_TRUST_MATRIX.md. No es asesoría jurídica ni una
// política legal completa; lo dice explícitamente al final. Nada aquí
// inventa una garantía, un plazo o una cobertura que no exista.
const whatsappLink = buildWhatsappLink(MENSAJE_CONTACTO_GENERAL);
---

<Layout title="Términos — Maygel" description="Información clara sobre cómo trabajamos: fabricación, pagos, envíos y cambios en Maygel.">
	<Header />
	<main id="contenido">
		<section class="terminos section">
			<div class="container terminos__inner">
				<h1 class="terminos__titulo">Términos</h1>
				<p class="terminos__lead">
					Aquí te explicamos, de forma simple, cómo trabajamos. Si tienes cualquier duda,
					escríbenos por WhatsApp.
				</p>

				<article class="terminos__bloque">
					<h2>Fabricación</h2>
					<p>
						Cada sandalia se fabrica después de que confirmas tu pedido — no tenemos inventario
						previo. Por eso el tiempo de fabricación empieza a contar desde que confirmamos tu
						talla y color.
					</p>
				</article>

				<article class="terminos__bloque">
					<h2>Contacto</h2>
					<p>
						Todo pedido, duda o cambio se resuelve por WhatsApp, hablando directamente con
						nosotros:{" "}
						<a href={whatsappLink} target="_blank" rel="noopener noreferrer">Escríbenos aquí</a>.
					</p>
				</article>

				<article class="terminos__bloque">
					<h2>Pagos</h2>
					<p>Aceptamos Nequi, Bancolombia, Llave, efectivo y, según la ciudad, contraentrega.</p>
				</article>

				<article class="terminos__bloque">
					<h2>Entregas</h2>
					<p>
						Entregamos en Soledad (con pago contraentrega) y Barranquilla (domicilio a cargo de la
						clienta, entre $10.000 y $15.000 COP). En Cartagena solo atendemos pedidos al por
						mayor. No confirmamos envíos a otras ciudades para pedidos individuales.
					</p>
				</article>

				<article class="terminos__bloque">
					<h2>Cambios</h2>
					<p>
						Aceptamos cambios por talla, por pequeños detalles o por defectos de fabricación. El
						envío del cambio se cobra nuevamente — no está incluido.
					</p>
				</article>

				<article class="terminos__bloque">
					<h2>Mayoristas</h2>
					<p>
						Las ventas al por mayor se atienden únicamente por WhatsApp, donde confirmamos
						modelos, cantidades y precios caso por caso.
					</p>
				</article>

				<article class="terminos__bloque terminos__bloque--aviso">
					<h2>Aviso</h2>
					<p>
						Esta página describe cómo trabajamos hoy, con la información que tenemos confirmada.
						No es asesoría jurídica ni una política legal completa (privacidad, garantías
						extendidas u otros términos formales pueden desarrollarse más adelante si el negocio
						lo decide).
					</p>
				</article>
			</div>
		</section>
	</main>
	<ContactFooter />
</Layout>

<style>
	.terminos__inner {
		max-width: 62ch;
	}

	.terminos__titulo {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 800;
		margin-bottom: 1.25rem;
	}

	.terminos__lead {
		font-size: 1.1875rem;
		color: var(--color-text);
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}

	.terminos__bloque {
		border-top: 1px solid var(--color-line);
		padding-top: 1.75rem;
		margin-bottom: 1.75rem;
	}

	.terminos__bloque h2 {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 800;
		margin-bottom: 0.75rem;
	}

	.terminos__bloque p {
		color: var(--color-text);
		font-size: 1.0625rem;
	}

	.terminos__bloque--aviso p {
		color: var(--color-accent-soft);
		font-size: 0.9375rem;
	}

	.terminos__bloque a {
		color: var(--color-accent);
		text-decoration: underline;
	}
</style>
