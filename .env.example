# Copia este archivo como ".env" y rellena los valores.
# El archivo .env NO se sube a git ni se comparte.

# Usuario y contraseña para entrar a /admin
ADMIN_USER=maygel
ADMIN_PASSWORD=cambia-esta-clave

# Cadena aleatoria larga que firma la cookie de sesión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esta-cadena-por-una-aleatoria-larga

# Token del Blob Store de Vercel (para subir las fotos).
# Lo da Vercel al crear el store: Storage > Blob > .env.local
BLOB_READ_WRITE_TOKEN=

# Solo en producción (Astro Studio / Turso):
# ASTRO_DB_REMOTE_URL=
# ASTRO_DB_APP_TOKEN=
